{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "moviestracker",
      "runtimeExecutable": "make",
      "runtimeArgs": [
        "dev"
      ],
      "port": 8095,
      "autoPort": true
    },
    {
      "name": "moviestracker-web",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=8096",
        "go",
        "run",
        "./cmd/web"
      ],
      "port": 8096
    }
  ]
}
