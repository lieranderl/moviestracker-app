package views

import (
	"fmt"
	"time"

	"github.com/lieranderl/moviestracker-app/internal/auth"
	"github.com/lieranderl/moviestracker-app/internal/store"
	"github.com/lieranderl/moviestracker-app/internal/torrserver"
)

// webTorrServerSignals are the TorrServer page's signals: the address picked
// in this browser (else the first), what it answered, and the add form. The
// form's login never leaves the browser (filterSignals below).
func webTorrServerSignals(servers []store.TorrServer) string {
	first := ""
	if len(servers) > 0 {
		first = servers[0].URL
	}
	return fmt.Sprintf(`{ tsSelected: localStorage.getItem('mt-ts-selected') || %q, tsStatus: {checking: false, ok: false, version: '', hls: false, problem: '', status: 0}, tsAddOpen: %t, tsName: '', tsUrl: '', tsUser: '', tsPass: '', tsFormError: '', tsForget: '' }`, first, len(servers) == 0)
}

// webTorrServerAdd saves the form's login in this browser, then sends only
// the name and address.
const webTorrServerAdd = `tsSaveLogin($tsUrl.trim().replace(/\/+$/, ''), $tsUser.trim(), $tsPass); @post('/api/torrservers', {filterSignals: {include: /^ts(Name|Url)$/}})`

// webTorrServerEffects keep the pick in this browser and tell the navbar's
// status ($_tsNavUrl), and forget the login
// of a TorrServer the server has removed ($tsForget).
const webTorrServerEffects = `localStorage.setItem('mt-ts-selected', $tsSelected); $_tsNavUrl = $tsSelected; if ($tsForget) { tsForgetLogin($tsForget); $tsForget = '' }`

// WebTorrServerPage is the web app's TorrServer page: the user's
// TorrServers, reached from their browser.
templ WebTorrServerPage(user *auth.User, servers []store.TorrServer, settings []SettingsSection) {
	@layoutWithScripts(tr(ctx, "TorrServer"), "/static/torrserver.js", "/static/player.js") {
		@Navbar(user)
		<main class="grow pb-20" data-signals={ webTorrServerSignals(servers) } data-effect={ webTorrServerEffects }>
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 space-y-6">
				<header class="flex flex-wrap items-end justify-between gap-4">
					<div class="space-y-1">
						<h1 class="text-2xl sm:text-3xl font-bold tracking-tight flex items-center gap-2">
							@Icon("server", "size-6 text-primary")
							TorrServer
						</h1>
						<p class="text-sm text-base-content/70 max-w-2xl">{ tr(ctx, "Your own TorrServer streams to this browser directly: Moviestracker only keeps its address, and its login stays in this browser.") }</p>
					</div>
					<button type="button" class="btn btn-primary btn-sm gap-2" data-on:click="$addModalOpen = true">
 @Icon("plus", "size-4")
 {tr(ctx,"Add Torrents")}
 </button>
 <button type="button" class="btn btn-outline btn-sm gap-2" data-on:click="$tsAddOpen = !$tsAddOpen">
						@Icon("plus", "size-4")
						{ tr(ctx, "Add TorrServer") }
					</button>
				</header>
				@webTorrServerForm()
				@WebTorrServers(servers)
				@webTorrServerStatus()
                @webSettings(settings)
				<div data-signals={ webPlayerSignals() }>
					@webTorrentsBox()
					@webPlayer()
				</div>
			</div>
		</main>
		@siteFooter()
	}
}

templ webTorrServerForm() {
	<form class="card bg-base-200/60 border border-base-content/10" data-show="$tsAddOpen" data-on:submit={ webTorrServerAdd }>
		<div class="card-body gap-4">
			<h2 class="card-title text-base">{ tr(ctx, "Add TorrServer") }</h2>
			<div class="grid sm:grid-cols-2 gap-3">
				<fieldset class="fieldset">
					<legend class="fieldset-legend">{ tr(ctx, "Address") }</legend>
					<input type="url" required class="input w-full" placeholder="http://localhost:8090" data-bind:ts-url/>
				</fieldset>
				<fieldset class="fieldset">
					<legend class="fieldset-legend">{ tr(ctx, "Name") }</legend>
					<input type="text" maxlength="80" class="input w-full" placeholder={ tr(ctx, "My TorrServer") } data-bind:ts-name/>
				</fieldset>
				<fieldset class="fieldset">
					<legend class="fieldset-legend">{ tr(ctx, "Username (if it asks for one)") }</legend>
					<input type="text" autocomplete="off" class="input w-full" data-bind:ts-user/>
				</fieldset>
				<fieldset class="fieldset">
					<legend class="fieldset-legend">{ tr(ctx, "Password") }</legend>
					<input type="password" autocomplete="off" class="input w-full" data-bind:ts-pass/>
				</fieldset>
			</div>
			<p class="text-xs text-base-content/70">{ tr(ctx, "On this computer TorrServer is usually at http://localhost:8090. On another machine, use its HTTPS address.") }</p>
			<div role="alert" class="alert alert-error alert-soft text-sm" data-show="$tsFormError">
				@Icon("circle-alert", "size-4")
				<span data-text="$tsFormError"></span>
			</div>
			<div class="card-actions justify-end">
				<button type="button" class="btn btn-ghost btn-sm" data-on:click="$tsAddOpen = false">{ tr(ctx, "Cancel") }</button>
				<button type="submit" class="btn btn-primary btn-sm">{ tr(ctx, "Save") }</button>
			</div>
		</div>
	</form>
}

// WebTorrServers is the user's TorrServers, one picked in this browser.
templ WebTorrServers(servers []store.TorrServer) {
	<section id="ts-servers" class="space-y-2" aria-label={ tr(ctx, "Your TorrServers") }>
		if len(servers) == 0 {
			@emptyState("server", tr(ctx, "No TorrServer yet"), tr(ctx, "Add the address of yours to list and play its torrents here.")) {
				<button type="button" class="btn btn-primary btn-sm gap-2" data-on:click="$tsAddOpen = true">
					@Icon("plus", "size-4")
					{ tr(ctx, "Add TorrServer") }
				</button>
			}
		}
		for _, s := range servers {
			<div class="flex items-center gap-3 rounded-box bg-base-200/60 border border-base-content/10 px-4 py-3">
				<input type="radio" name="ts-selected" class="radio radio-primary radio-sm" value={ s.URL } data-bind:ts-selected aria-label={ s.Name }/>
				<div class="min-w-0 grow">
					<p class="font-semibold truncate">{ s.Name }</p>
					<p class="text-xs font-mono text-base-content/70 truncate">{ s.URL }</p>
				</div>
				<button
					type="button"
					class="btn btn-ghost btn-sm btn-square text-error"
					aria-label={ trf(ctx, "Remove %s", s.Name) }
					data-on:click={ fmt.Sprintf("@delete('/api/torrservers/%s', {filterSignals: {include: /^tsSelected$/}})", s.ID) }
				>
					@Icon("trash-2", "size-4")
				</button>
			</div>
		}
	</section>
}

// webTorrServerStatus checks the picked TorrServer from this browser
// (tsCheck) and explains what it answered.
templ webTorrServerStatus() {
	<section
		id="ts-status"
		class="card bg-base-200/60 border border-base-content/10"
		data-show="$tsSelected"
		data-effect="tsCheck(el, $tsSelected)"
		data-on:ts-status="$tsStatus = evt.detail"
	>
		<div class="card-body gap-3">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<h2 class="card-title text-base">{ tr(ctx, "Connection") }</h2>
				<button type="button" class="btn btn-ghost btn-sm gap-2" data-on:click="tsCheck(el.closest('#ts-status'), $tsSelected)">
					@Icon("refresh-cw", "size-4")
					{ tr(ctx, "Check again") }
				</button>
			</div>
			<p class="text-sm text-base-content/70 flex items-center gap-2" data-show="$tsStatus.checking">
				<span class="loading loading-spinner loading-xs"></span>
				{ tr(ctx, "Checking…") }
			</p>
			<div class="flex flex-wrap gap-2" data-show="$tsStatus.ok">
				<span class="badge badge-success badge-soft gap-1.5">
					@Icon("circle-check", "size-3.5")
					<span data-text={ trJS(ctx, "Connected") + " + ' · ' + $tsStatus.version" }></span>
				</span>
				<span class="badge badge-info badge-soft gap-1.5" data-show="$tsStatus.hls">
					@Icon("wand-sparkles", "size-3.5")
					{ tr(ctx, "HLS conversion available") }
				</span>
			</div>
			<p class="text-sm text-base-content/70" data-show="$tsStatus.ok && !$tsStatus.hls">{ tr(ctx, "This TorrServer has no GStreamer, so videos play only in formats the browser supports. Its -gst build converts the others to HLS.") }</p>
			for _, p := range tsProblems {
				@tsProblem(p.Problem, p.Message)
			}
			<div
				id="ts-https"
				data-effect="tsSSL(el, $tsStatus.ok ? $tsSelected : '')"
				data-on:ts-ssl="@post('/api/ts/https', {payload: {status: evt.detail}})"
			>
				<div id="ts-https-details"></div>
			</div>
		</div>
	</section>
}

// WebCertificate shows, read-only, the HTTPS certificate of the TorrServer
// the browser checked (tsSSL); nothing when it serves no HTTPS or cannot say.
templ WebCertificate(st *torrserver.SSLStatus, now time.Time) {
	<div id="ts-https-details">
		if st != nil && st.Enabled {
			<div class="pt-3 border-t border-base-content/10 space-y-3">
				<h3 class="text-sm font-medium flex items-center gap-2">
					@Icon("shield-check", "size-4 text-primary")
					{ tr(ctx, "HTTPS certificate") }
				</h3>
				@CertificateDetails(*st, now)
			</div>
		}
	</div>
}

// tsProblems explain why the browser could not reach a TorrServer, by the
// problem tsCheck names.
var tsProblems = []struct{ Problem, Message string }{
	{"mixed", "This page is served over HTTPS, so the browser blocks a plain http:// TorrServer on another machine. Use its HTTPS address (TorrServer --ssl with a trusted certificate), or TorrServer on this computer at http://localhost:8090."},
	{"unreachable", "TorrServer did not answer. Check that it runs at this address and that the browser may reach it (Chrome asks once to allow local network access). With a self-signed HTTPS certificate, open the address once in this browser and accept it."},
	{"login", "TorrServer asks for a login. Remove it and add it again with its username and password."},
	{"timeout", "TorrServer took too long to answer."},
	{"status", "TorrServer answered with an error."},
}

templ tsProblem(problem, message string) {
	<div role="alert" class="alert alert-warning alert-soft text-sm" data-show={ fmt.Sprintf("$tsStatus.problem === %q", problem) }>
		@Icon("triangle-alert", "size-4")
		<span>{ tr(ctx, message) }</span>
	</div>
}
