package views

import (
	"context"
	"github.com/lieranderl/moviestracker-app/internal/auth"
	"github.com/lieranderl/moviestracker-app/internal/tmdb"
	"strconv"
)

func movieFacts(ctx context.Context, m *tmdb.MovieDetails) []string {
	facts := []string{tr(ctx, "Movie")}
	if y := m.ReleaseYear(); y != "" {
		facts = append(facts, y)
	}
	if r := runtime(ctx, m.Runtime); r != "" {
		facts = append(facts, r)
	}
	return facts
}

func movieAbout(ctx context.Context, m *tmdb.MovieDetails) []factItem {
	return []factItem{
		{Label: "Directed by", People: m.Directors},
		{Label: "Written by", People: m.Writers},
		{Label: "Genres", Value: genreNames(m.Genres)},
		{Label: "Release date", Value: m.ReleaseDate},
		{Label: "Runtime", Value: runtime(ctx, m.Runtime)},
		{Label: "Budget", Value: movieMoney(m.Budget)},
		{Label: "Box office", Value: movieMoney(m.Revenue)},
		{Label: "Status", Value: tr(ctx, m.Status)},
		{Label: "Original title", Value: originalTitle(m.OriginalTitle, m.Title)},
	}
}

// TMDB movie finances are US dollars; zero means the amount is unknown.
func movieMoney(amount int64) string {
	if amount <= 0 {
		return ""
	}
	digits := strconv.FormatInt(amount, 10)
	for i := len(digits) - 3; i > 0; i -= 3 {
		digits = digits[:i] + "," + digits[i:]
	}
	return "$" + digits
}

func originalTitle(original, title string) string {
	if original == title {
		return ""
	}
	return original
}

templ MoviePage(user *auth.User, m *tmdb.MovieDetails) {
	@layoutWithScripts(PageTitle(m.MediaItem), titleScripts(ctx)...) {
		@Navbar(user)
		<main class="grow pb-16" data-signals={ mediaPageSignals } data-on:click={ videoClick(ctx) }>
			@detailHero(m.MediaItem, movieFacts(ctx, m), m.Certification, genreNames(m.Genres)) {
				@trailerButton(m.TrailerKey, trf(ctx, "%s trailer", m.Title))
				if siteOf(ctx).Cloud {
					@favoriteSlot("movie", m.ID)
				}
				@heroLink("#sources", "magnet", tr(ctx, "Find sources"))
			}
			@aboutSection(m.MediaItem, m.Tagline, movieAbout(ctx, m), officialLinks("title", m.Links, m.Homepage))
			@sourcesSection("movie", m.MediaItem, nil, 0, m.Releases)
			@castRail(tr(ctx, "Cast"), m.Cast)
			@videoRail(m.Videos)
			@collectionRail(m.Collection, m.ID)
			@mediaRail("recommendations", tr(ctx, "Recommended"), m.Recommendations)
			@mediaRail("similar", tr(ctx, "More like this"), m.Similar)
			@trailerModal()
			@appToast()
		</main>
		@siteFooter()
	}
}

// collectionRail lists the films of the movie's collection in release
// order, the movie itself marked.
templ collectionRail(c *tmdb.Collection, current int) {
	if c != nil {
		@rail("collection", c.Name, "") {
			for _, item := range c.Parts {
				if item.ID == current {
					<li class="carousel-item rounded-box ring-2 ring-primary ring-offset-2 ring-offset-base-100" aria-current="page">
						@MediaCard(item)
					</li>
				} else {
					<li class="carousel-item">
						@MediaCard(item)
					</li>
				}
			}
		}
	}
}
