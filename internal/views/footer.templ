package views

// TMDBDisclaimer is the attribution wording required by the TMDB API terms.
const TMDBDisclaimer = "This product uses the TMDB API but is not endorsed or certified by TMDB."

const (
	tmdbHomeURL     = "https://www.themoviedb.org/"
	torrentIndexURL = "https://jacred.su/"
	// jacredReferralURL is Moviestracker's jacred.su project link, which the
	// project's terms ask to show beside the results ("search is powered by
	// JacRed"); jacred.su counts the visits it brings.
	jacredReferralURL = "https://jacred.su/r/c2abc53e-233f-42ad-9f6a-e12f2eeaef9c" // #nosec G101 -- a public referral link, not a credential
	torrServerURL   = "https://github.com/YouROK/TorrServer"
	gstreamerURL    = "https://gstreamer.freedesktop.org/"
	// SourceURL is where Moviestracker's source code is. AGPL-3.0 section 13
	// asks every copy, modified ones included, to offer its source to the
	// people who use it over the network: a fork links its own source here.
	SourceURL = "https://github.com/lieranderl/moviestracker-app"
)

// siteFooter is the signed-in pages' footer, with the version.
templ siteFooter() {
	@footer(true)
}

// footer credits the sources and tools; showVersion is off on public pages,
// so strangers cannot tell which version runs.
templ footer(showVersion bool) {
	<footer class="footer sm:footer-horizontal bg-base-200 text-base-content/70 px-6 sm:px-10 py-10 border-t border-base-content/10 mt-auto">
		<aside class="max-w-sm space-y-3">
			@brand("/")
			<p class="text-xs leading-relaxed">
				{ tr(ctx, "A free, non-commercial personal catalog. Moviestracker does not host, upload, seed or distribute media.") }
			</p>
			if IsCloud(ctx) {
				<a href={ templ.SafeURL(PrivacyPath) } class="link link-hover text-xs">{ tr(ctx, "Privacy policy") }</a>
			}
		</aside>
		<nav aria-label={ tr(ctx, "Data sources") }>
			<h2 class="footer-title">{ tr(ctx, "Data sources") }</h2>
			@externalLink(tmdbHomeURL, "The Movie Database (TMDB)")
			@externalLink(torrentIndexURL, tr(ctx, "JacRed torrent index"))
			<p class="text-xs max-w-xs">{ tr(ctx, TMDBDisclaimer) }</p>
		</nav>
		<nav aria-label={ tr(ctx, "Streaming") }>
			<h2 class="footer-title">{ tr(ctx, "Streaming") }</h2>
			@externalLink(torrServerURL, "TorrServer")
			@externalLink(gstreamerURL, "GStreamer")
			<p class="text-xs max-w-xs">{ tr(ctx, "TorrServer streams torrents; GStreamer converts MKV files for the browser.") }</p>
		</nav>
		<nav aria-label={ tr(ctx, "Built with") }>
			<h2 class="footer-title">{ tr(ctx, "Built with") }</h2>
			@externalLink("https://go.dev", "Go")
			@externalLink("https://data-star.dev", "Datastar")
			@externalLink("https://daisyui.com", "DaisyUI")
			@externalLink(SourceURL, tr(ctx, "Source code (AGPL-3.0)"))
			if label := tr(ctx, versionLabel()); showVersion && label != "" {
				<p class="text-xs font-mono text-base-content/50 pt-2">{ label }</p>
			}
		</nav>
	</footer>
}

templ externalLink(href templ.SafeURL, label string) {
	<a href={ href } target="_blank" rel="noopener noreferrer" class="link link-hover text-xs inline-flex items-center gap-1">
		{ label }
		@Icon("external-link", "size-3")
		<span class="sr-only">{ tr(ctx, "(opens in new tab)") }</span>
	</a>
}

// JacRedCredit credits JacRed, which finds the releases, beside them.
templ JacRedCredit() {
	<a href={ jacredReferralURL } target="_blank" rel="noopener noreferrer" class="badge badge-primary badge-soft gap-1.5 hover:badge-outline shrink-0 whitespace-nowrap">
		@Icon("magnet", "size-3.5")
		{ tr(ctx, "Search is powered by JacRed") }
		@Icon("external-link", "size-3")
		<span class="sr-only">{ tr(ctx, "(opens in new tab)") }</span>
	</a>
}
