package views

import (
	"context"

	"github.com/lieranderl/moviestracker-app/internal/auth"
	"github.com/lieranderl/moviestracker-app/internal/tmdb"
)

// My lists' tabs.
const (
	ListFavorites = "favorites"
	ListWant      = "want"
	ListWatched   = "watched"
)

type listTab struct {
	ID, Href, Label, Icon string
	Empty, EmptyHelp      string
	Failed                string
}

// listTabs are My lists' tabs on ctx's site: only the web app keeps
// favourites.
func listTabs(ctx context.Context) []listTab {
	tabs := []listTab{
		{ID: ListWant, Href: "/lists/want", Label: "Want to watch", Icon: "bookmark",
			Empty: "Nothing to watch yet", EmptyHelp: "Open a movie or series and press Want to watch.",
			Failed: "Your list could not be loaded right now. Please try again in a moment."},
		{ID: ListWatched, Href: "/lists/watched", Label: "Watched", Icon: "eye",
			Empty: "Nothing watched yet", EmptyHelp: "Press Watched on a title, or finish a movie in the player.",
			Failed: "Your list could not be loaded right now. Please try again in a moment."},
	}
	if siteOf(ctx).Cloud {
		tabs = append([]listTab{{ID: ListFavorites, Href: "/favorites", Label: "Favourites", Icon: "heart",
			Empty: "No favourites yet", EmptyHelp: "Open a movie or series and press Add to favourites.",
			Failed: "Your favourites could not be loaded right now. Please try again in a moment."}}, tabs...)
	}
	return tabs
}

// ListsPage is My lists on the tab named active, its titles newest first;
// failed says they could not be read.
templ ListsPage(user *auth.User, active string, items []tmdb.MediaItem, failed bool) {
	@listsLayout(user, active) {
		for _, tab := range listTabs(ctx) {
			if tab.ID == active {
				if failed {
					<div role="alert" class="alert alert-error alert-soft">
						@Icon("circle-alert", "size-5")
						<span>{ tr(ctx, tab.Failed) }</span>
					</div>
				} else if len(items) == 0 {
					@emptyState(tab.Icon, tr(ctx, tab.Empty), tr(ctx, tab.EmptyHelp)) {
						@browseTrendingLink()
					}
				} else {
					<ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
						@BrowseItems(items)
					</ul>
				}
			}
		}
	}
}

// listsLayout is My lists with the tab active open: the fixed tabs, then
// the user's own lists, which it asks for.
templ listsLayout(user *auth.User, active string) {
	@Layout(tr(ctx, "My lists")) {
		@Navbar(user)
		<main class="grow pb-20">
			<div class="max-w-7xl mx-auto px-4 sm:px-8 mt-8 space-y-6">
				<header class="space-y-3">
					<h1 class="text-2xl sm:text-3xl font-bold tracking-tight flex items-center gap-2">
						@Icon("library", "size-6 text-primary")
						{ tr(ctx, "My lists") }
					</h1>
					<nav role="tablist" class="tabs tabs-box w-fit max-w-full flex-nowrap overflow-x-auto" aria-label={ tr(ctx, "My lists") }>
						for _, tab := range listTabs(ctx) {
							<a href={ templ.SafeURL(tab.Href) } role="tab" aria-selected={ boolAttr(tab.ID == active) } class={ "tab gap-2 shrink-0", templ.KV("tab-active", tab.ID == active) }>
								@Icon(tab.Icon, "size-4")
								{ tr(ctx, tab.Label) }
							</a>
						}
						@customListTabsSlot(active)
					</nav>
				</header>
				{ children... }
			</div>
			@newListDialog()
			@toTopButton()
		</main>
		@siteFooter()
	}
}
