package views

import (
	"context"

	"github.com/lieranderl/moviestracker-app/internal/auth"
	"github.com/lieranderl/moviestracker-app/internal/tmdb"
)

// My lists' tabs.
const (
	ListFavorites = "favorites"
	ListWant      = "want"
	ListWatched   = "watched"
)

type listTab struct {
	ID, Href, Label, Icon string
	Empty, EmptyHelp      string
	Failed                string
}

// listTabs are My lists' tabs on ctx's site: only the web app keeps
// favourites.
func listTabs(ctx context.Context) []listTab {
	tabs := []listTab{
		{ID: ListWant, Href: "/lists/want", Label: "Want to watch", Icon: "bookmark",
			Empty: "Nothing to watch yet", EmptyHelp: "Open a movie or series and press Want to watch.",
			Failed: "Your list could not be loaded right now. Please try again in a moment."},
		{ID: ListWatched, Href: "/lists/watched", Label: "Watched", Icon: "eye",
			Empty: "Nothing watched yet", EmptyHelp: "Press Watched on a title, or finish a movie in the player.",
			Failed: "Your list could not be loaded right now. Please try again in a moment."},
	}
	if siteOf(ctx).Cloud {
		tabs = append([]listTab{{ID: ListFavorites, Href: "/favorites", Label: "Favourites", Icon: "heart",
			Empty: "No favourites yet", EmptyHelp: "Open a movie or series and press Add to favourites.",
			Failed: "Your favourites could not be loaded right now. Please try again in a moment."}}, tabs...)
	}
	return tabs
}

// LibraryQuery is how a library list is searched (Q), narrowed to movies or
// series (Kind) and sorted (Sort: "" for most recent, "title" or "rating"),
// from its address; Count is how many titles match it.
type LibraryQuery struct {
	Q, Kind, Sort string
	Count         int
}

// Active says whether the list is searched, narrowed or sorted.
func (q LibraryQuery) Active() bool { return q.Q != "" || q.Kind != "" || q.Sort != "" }

// libraryControls search, narrow and sort a library list with a GET form,
// so each view has its own address to share.
templ libraryControls(q LibraryQuery) {
	<form method="get" class="flex flex-wrap items-end gap-2" role="search">
		<label class="input input-sm w-full sm:w-64">
			@Icon("search", "size-4 opacity-60")
			<input type="search" name="q" value={ q.Q } maxlength="100" placeholder={ tr(ctx, "Search this list") } aria-label={ tr(ctx, "Search this list") }/>
		</label>
		<select name="kind" class="select select-sm w-auto" aria-label={ tr(ctx, "Movies or series") }>
			<option value="" selected?={ q.Kind == "" }>{ tr(ctx, "Movies and series") }</option>
			<option value="movie" selected?={ q.Kind == "movie" }>{ tr(ctx, "Movies") }</option>
			<option value="tv" selected?={ q.Kind == "tv" }>{ tr(ctx, "Series") }</option>
		</select>
		<select name="sort" class="select select-sm w-auto" aria-label={ tr(ctx, "Sort by") }>
			<option value="" selected?={ q.Sort == "" }>{ tr(ctx, "Most recent") }</option>
			<option value="title" selected?={ q.Sort == "title" }>{ tr(ctx, "Title") }</option>
			<option value="rating" selected?={ q.Sort == "rating" }>{ tr(ctx, "My rating") }</option>
		</select>
		<button type="submit" class="btn btn-sm btn-primary">{ tr(ctx, "Apply") }</button>
		if q.Active() {
			<span class="text-sm text-base-content/70 self-center">{ trn(ctx, q.Count, "%d title", "%d titles") }</span>
		}
	</form>
}

// ListsPage is My lists on the tab named active, its titles newest first
// unless q says otherwise; failed says they could not be read.
templ ListsPage(user *auth.User, active string, items []tmdb.MediaItem, more string, q LibraryQuery, failed bool) {
	@listsLayout(user, active) {
		for _, tab := range listTabs(ctx) {
			if tab.ID == active {
				if !failed && (len(items) > 0 || q.Active()) {
					@libraryControls(q)
				}
				if failed {
					<div role="alert" class="alert alert-error alert-soft">
						@Icon("circle-alert", "size-5")
						<span>{ tr(ctx, tab.Failed) }</span>
					</div>
				} else if len(items) == 0 && q.Active() {
					<p class="text-sm text-base-content/70">{ tr(ctx, "No titles match.") }</p>
				} else if len(items) == 0 {
					@emptyState(tab.Icon, tr(ctx, tab.Empty), tr(ctx, tab.EmptyHelp)) {
						@browseTrendingLink()
					}
				} else {
					<ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
						@BrowseItems(items)
					</ul>
					if more != "" {
						<div class="flex justify-center">
							<a href={ templ.SafeURL(more) } class="btn btn-outline btn-primary gap-1.5">
								{ tr(ctx, "Show more") }
								@Icon("chevron-down", "size-4")
							</a>
						</div>
					}
				}
			}
		}
	}
}

// listsLayout is My lists with the tab active open: the fixed tabs, then
// the user's own lists, which it asks for.
templ listsLayout(user *auth.User, active string) {
	@Layout(tr(ctx, "My lists")) {
		@Navbar(user)
		<main class="grow pb-20">
			<div class="max-w-7xl mx-auto px-4 sm:px-8 mt-8 space-y-6">
				<header class="space-y-3">
					<h1 class="text-2xl sm:text-3xl font-bold tracking-tight flex items-center gap-2">
						@Icon("library", "size-6 text-primary")
						{ tr(ctx, "My lists") }
					</h1>
					@ListTabs(active, nil, true)
				</header>
				<div id="lists-hint"></div>
				{ children... }
			</div>
			@newListDialog()
			@toTopButton()
		</main>
		@siteFooter()
	}
}
