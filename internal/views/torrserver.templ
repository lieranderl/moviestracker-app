package views

import (
	"context"
	"encoding/json"
	"fmt"
	"path"
	"strings"
	"time"

	"github.com/lieranderl/moviestracker-app/internal/auth"
	"github.com/lieranderl/moviestracker-app/internal/torrserver"
)

// torrPageSignals is the client state for the TorrServer page. $gst mirrors
// TorrServer's GStreamer support (kept current by the SSE stream) and gates
// every HLS/probe control.
func torrPageSignals(gst, canRemove bool, linkOrigin string) string {
	origin, _ := json.Marshal(linkOrigin)
	return fmt.Sprintf(`{
	gst: %t, canRemove: %t, linkOrigin: %s,
	playerOpen: false, streamUrl: '', streamCleanUrl: '', streamHlsUrl: '', streamTitle: '', activeHash: '', activeFileIndex: 1,
	streamBase: '', playKind: 'direct', playNonce: 0, audioTrack: -1, mediaInfoOpen: false, subTrack: -1,
	_seekHint: '', _seekSum: 0, _seekAt: 0, _zone: '',
	_paused: true, _time: 0, _dur: 0, _vol: 1, _muted: false, _fs: false, _idle: false, _waiting: false, _seeking: false, _unplayable: '',
	_queue: [], _queueHash: '', _listMenu: false,
	_audioMenu: false, _subMenu: false, audioLang: localStorage.getItem('torrAudioLang') || '',
	addModalOpen: false,
	probeOpen: false, probeHash: '', probeIndex: 1, probeLoading: false,
	fileMenuOpen: false, _file: {hash: '', index: 1, title: '', clean: '', hls: '', video: false},
	confirmOpen: false, confirmHash: '', confirmName: '',
	filterQuery: '', toast: '', toastError: false
}`, gst, canRemove, origin)
}

// torrListActions is the single delegated click handler for every torrent and
// file action button. Buttons declare intent via data-action and carry their
// payload in data-* attributes, so no JS strings are built from torrent data.
func torrListActions(ctx context.Context) string {
	return `
const btn = evt.target.closest('button[data-action]')
if (!btn) return
const d = btn.dataset
const hash = encodeURIComponent(d.hash)
switch (d.action) {
	case 'play':
		$streamCleanUrl = d.clean || ''; $streamHlsUrl = d.hls || ''; $streamTitle = d.title; $activeHash = d.hash; $activeFileIndex = +d.index
		$playKind = d.kind === 'hls' && $gst ? 'hls' : 'direct'
		` + torrStartPlay + `
		break
	case 'probe':
		$probeHash = d.hash; $probeIndex = +d.index; $probeOpen = true
		break
	case 'more':
		` + openFileMenu("d.clean", "d.hls") + `
		break
	case 'copy':
		window.copyLink(d.url, $linkOrigin).then(ok => { $toastError = !ok; $toast = ok ? d.msg : ` + trJS(ctx, "Copy failed") + ` })
		break
	case 'files':
		@post('/api/torrserver/files?hash=' + hash, {filterSignals: {include: /^$/}})
		break
	case 'drop':
		@post('/api/torrserver/action?op=drop&hash=' + hash, {filterSignals: {include: /^$/}})
		break
	case 'remove':
		$confirmHash = d.hash; $confirmName = d.title; $confirmOpen = true
		break
}
`
}

// torrStartPlay (re)starts the player on $activeHash's file as $playKind:
// Direct streams the original file, HLS goes through GStreamer and first
// asks which audio tracks the file has.
const torrStartPlay = `{
	$audioTrack = -1; $subTrack = -1; $_audioMenu = false; $_subMenu = false
	const h = encodeURIComponent($activeHash)
	$streamBase = $playKind === 'hls'
		? '/api/torrserver/stream/gst/' + h + '/master.m3u8?index=' + $activeFileIndex
		: '/api/torrserver/stream/stream?link=' + h + '&index=' + $activeFileIndex + '&play'
	$playNonce++
	$playerOpen = true
	if ($playKind === 'hls') {
		@get('/api/torrserver/tracks?hash=' + h + '&index=' + $activeFileIndex, {filterSignals: {include: /^audioLang$/}})
	} else {
		$audioTrack = 0
	}
}`

// torrQueueAt is where the playing file is in the torrent's playlist
// ($_queue, sent by /api/torrserver/queue), or -1.
const torrQueueAt = `($_queueHash === $activeHash ? $_queue.findIndex(f => f.index === $activeFileIndex) : -1)`

// torrHasNext is whether the playlist goes on after the playing file.
const torrHasNext = `(` + torrQueueAt + ` >= 0 && ` + torrQueueAt + ` < $_queue.length - 1)`

// torrPlayQueued plays the playlist's file at position at, in the stream
// kind already chosen.
func torrPlayQueued(at string) string {
	return `{
	const f = $_queue[` + at + `]
	$streamCleanUrl = f.clean; $streamHlsUrl = f.hls; $streamTitle = f.title; $activeFileIndex = f.index
	` + torrStartPlay + `
}`
}

// torrPlayNext goes on to the playlist's next file, if there is one: when a
// file ends, or on Next.
var torrPlayNext = `if ` + torrHasNext + ` ` + torrPlayQueued(torrQueueAt+` + 1`)

// torrPlaylistPick plays the file picked in the playlist menu.
var torrPlaylistPick = `const b = evt.target.closest('[data-at]')
if (b) {
	$_listMenu = false
	` + torrPlayQueued(`+b.dataset.at`) + `
}`

// torrQueueFetch asks for the playing torrent's playlist whenever the player
// opens on a torrent.
const torrQueueFetch = `$playerOpen && $activeHash && @get('/api/torrserver/queue?hash=' + encodeURIComponent($activeHash), {filterSignals: {include: /^$/}})`

// torrWheelVolume turns the volume up as the wheel or the fingers go up,
// down as they go down: 5% a mouse notch, finer on a trackpad. Macs scroll
// "naturally" (inverted: fingers up scroll down), which Safari reports and
// other browsers leave to guess from the platform.
const torrWheelVolume = `if (!evt.deltaY) return
evt.preventDefault()
const inverted = evt.webkitDirectionInvertedFromDevice ?? (` + onMac + `)
const px = (evt.deltaMode ? evt.deltaY * 40 : evt.deltaY) * (inverted ? -1 : 1)
const v = $_video
v.muted = false
v.volume = Math.round(Math.min(1, Math.max(0, v.volume - Math.max(-0.05, Math.min(0.05, px / 2000)))) * 100) / 100
$_idle = false`

// onMac is true in a Mac's browser, where IINA runs.
const onMac = `/Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints < 2`

// openPlayer opens link (a Datastar expression) in an external player and
// says so when the browser could not: it has no handler for the player's
// links. VLC registers none on a computer without vlc-protocol.
func openPlayer(ctx context.Context, player, name, link string) string {
	msg := trf(ctx, "%s did not open: is it installed? Copy the Direct link and open it there instead", name)
	if player == "vlc" {
		msg = tr(ctx, "VLC did not open: is it installed, with vlc-protocol on a computer? Copy the Direct link and open it there instead")
	}
	return fmt.Sprintf(`window.openInPlayer('%s', %s, $linkOrigin).then(opened => opened || ($toastError = true, $toast = %s))`,
		player, link, jsString(msg))
}

// openFileMenu opens a file row's menu from its button's dataset d; clean and
// hls are expressions for the file's links as players open them.
func openFileMenu(clean, hls string) string {
	return `$_file = {hash: d.hash, index: +d.index, title: d.title, clean: ` + clean + `, hls: ` + hls + `, video: d.video === 'true'}; $fileMenuOpen = true`
}

// torrPlayback (re)starts the stream once the audio track is known: right
// after the tracks response on play, and again whenever the picker changes it.
const torrPlayback = `$playNonce && $playerOpen && $audioTrack >= 0 &&
	window.playHlsVideo($streamUrl = $streamBase + ($streamBase.includes('/gst/') ? '&audio=' + $audioTrack : ''))`

// torrPlayerStatsStream keeps the stats row (and, with GStreamer, the media
// info) current from one server stream while the player is open. The effect
// reruns when the torrent, file or audio track changes: Datastar then cancels
// the element's previous request, and closing the player sends stop=1 so the
// old stream ends.
const torrPlayerStatsStream = `$playerOpen && $activeHash
	? @get('/api/torrserver/player-stats?stream=true&hash=' + encodeURIComponent($activeHash) +
		($playKind === 'hls' ? '&gst=1&index=' + $activeFileIndex + '&audio=' + Math.max($audioTrack, 0) : ''), {filterSignals: {include: /^$/}})
	: @get('/api/torrserver/player-stats?stop=1', {filterSignals: {include: /^$/}})`

// torrControlsShown keeps the control bar up while paused, while the pointer
// moved in the last 3s, or while a track or playlist menu is open.
const torrControlsShown = `$_paused || !$_idle || $_audioMenu || $_subMenu || $_listMenu`

// torrFullscreenToggle fullscreens the player container (not the bare
// <video>) so the control bar and its menus stay available. iPhone Safari
// only supports native video fullscreen, hence the fallback.
const torrFullscreenToggle = `document.fullscreenElement ? document.exitFullscreen()
	: ($_player.requestFullscreen ? $_player.requestFullscreen() : $_video.webkitEnterFullscreen())`

// torrVideoDoubleTap: a double tap (or double click) on the left third of
// the video goes back 10 seconds, on the right third forward 10 seconds, as
// on phones' video apps; the middle toggles fullscreen. Taps in a row add up
// in the hint ("30 s").
const torrVideoDoubleTap = `const x = evt.offsetX / el.clientWidth
if (x < 1 / 3 || x > 2 / 3) {
	const step = x < 1 / 3 ? -10 : 10
	const dir = step < 0 ? 'back' : 'fwd'
	const end = Number.isFinite(el.duration) ? el.duration : Infinity
	el.currentTime = Math.min(Math.max(0, el.currentTime + step), end)
	$_seekSum = ($_seekHint === dir ? $_seekSum : 0) + 10
	$_seekHint = dir
	$_seekAt = Date.now()
} else {
	` + torrFullscreenToggle + `
}`

// torrVideoClick plays or pauses from the centre third only: the sides are
// for double taps that skip.
const torrVideoClick = `const x = evt.offsetX / el.clientWidth
if (x >= 1 / 3 && x <= 2 / 3) { el.paused ? el.play() : el.pause() }`

// torrVideoZone notes which third of the video the pointer is over.
const torrVideoZone = `$_zone = evt.offsetX < el.clientWidth / 3 ? 'back' : evt.offsetX > el.clientWidth * 2 / 3 ? 'fwd' : 'center'`

// torrTimeText renders "12:34 / 1:58:53"; hours only when the video has them.
const torrTimeText = `new Date(($_time || 0) * 1000).toISOString().slice($_dur >= 3600 ? 12 : 14, 19) + ' / ' +
	new Date(($_dur || 0) * 1000).toISOString().slice($_dur >= 3600 ? 12 : 14, 19)`

// torrPlayerKeys: space/k play-pause, f fullscreen, m mute, ←/→ seek 10s,
// ↑/↓ volume 5%.
// They work wherever focus is while the player is open (it opens with focus
// on a header button), except while typing; handled keys do nothing else, so
// space does not also press the focused button.
const torrPlayerKeys = `
if (!$playerOpen || evt.metaKey || evt.ctrlKey || evt.altKey) return
if (evt.target.closest('input:not([type=range]), textarea, select, [contenteditable]')) return
const v = $_video
const seek = (s) => { v.currentTime = Math.min(Math.max(0, v.currentTime + s), Number.isFinite(v.duration) ? v.duration : Infinity) }
const turn = (d) => { v.muted = false; v.volume = Math.round(Math.min(1, Math.max(0, v.volume + d)) * 100) / 100 }
switch (evt.key) {
	case ' ': case 'k': v.paused ? v.play() : v.pause(); break
	case 'f': ` + torrFullscreenToggle + `; break
	case 'm': v.muted = !v.muted; break
	case 'ArrowRight': seek(10); break
	case 'ArrowLeft': seek(-10); break
	case 'ArrowUp': turn(0.05); break
	case 'ArrowDown': turn(-0.05); break
	default: return
}
evt.preventDefault()
$_idle = false
`

// toastAutoHide clears the toast (and its error tone) 3s after the last
// change to $toast.
const toastAutoHide = `$toast && ($toast = '', $toastError = false)`

// playAttrs carries what the player needs to play one file.
func playAttrs(hash string, index int, title, clean, hls string) templ.Attributes {
	return templ.Attributes{
		"data-hash": hash, "data-index": fmt.Sprint(index), "data-title": title,
		"data-clean": clean, "data-hls": hls,
	}
}

// QueuedFile is one file of the player's playlist ($_queue).
type QueuedFile struct {
	Index int    `json:"index"`
	Title string `json:"title"`
	Clean string `json:"clean"`
	HLS   string `json:"hls"`
}

// PlayQueue is the player's playlist of a torrent: files, in order, never nil.
func PlayQueue(links StreamLinks, hash string, files []torrserver.FileStat) []QueuedFile {
	q := make([]QueuedFile, len(files))
	for i, f := range files {
		q[i] = QueuedFile{Index: f.ID, Title: f.Path, Clean: links.Direct(hash, f), HLS: links.HLS(hash, f)}
	}
	return q
}

// playlistPath downloads a torrent's .m3u8 of kind "direct" or "hls".
func playlistPath(hash, kind string) string {
	return "/api/torrserver/playlist?hash=" + hash + "&kind=" + kind
}

// StreamLinks make the links other devices and players open for one file:
// signed Moviestracker /s/ paths, so the TorrServer address never reaches the
// page. Direct plays the original file; HLS is GStreamer's conversion.
type StreamLinks struct {
	Direct, HLS func(hash string, f torrserver.FileStat) string
	// Browser uses the visitor's TorrServer transport.
	Browser bool
	// Page is the movie or TV page a torrent belongs to ("" when unknown);
	// nil knows none.
	Page func(hash string) string
}

// titlePage is where a torrent card links: its movie or TV page, a label
// for the icon and the icon's name ("" when the torrent's title is unknown).
func titlePage(links StreamLinks, hash string) (href, label, icon string) {
	if links.Page == nil {
		return "", "", ""
	}
	if href = links.Page(hash); href == "" {
		return "", "", ""
	}
	if strings.HasPrefix(href, "/tv/") {
		return href, "Open the TV page", "tv"
	}
	return href, "Open the movie page", "clapperboard"
}

// TorrServer is the TorrServer page. Its address is set in Settings → Sources.
templ TorrServer(user *auth.User, engine, linkOrigin string, links StreamLinks, echo torrserver.EchoInfo, torrents []torrserver.Torrent, gst GStreamerSetup) {
	@layoutWithScripts(tr(ctx, "TorrServer Web Player & Stream Manager"), "/static/player.js") {
		@Navbar(user)
		<main
			id="torrserver-app"
			class="grow w-full max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-6"
			data-signals={ torrPageSignals(echo.GSTAvailable, user.IsAdmin(), linkOrigin) }
		>
			<!-- Header & server status -->
			<section class="card bg-base-200/60 border border-base-content/10 shadow-lg">
				<div class="card-body gap-5 p-6 sm:p-8">
					<div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
						<div class="flex items-center gap-3">
							<span class="size-12 rounded-box bg-linear-to-tr from-primary to-accent grid place-items-center text-primary-content shadow-md shadow-primary/20">
								@Icon("server", "size-6")
							</span>
							<div>
								<h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">{ tr(ctx, "TorrServer Web Hub") }</h1>
								<p class="text-xs sm:text-sm text-base-content/70">
									{ tr(ctx, "In-browser HLS streaming, external player playlist export, and batch torrent management") }
								</p>
							</div>
						</div>
						<div class="flex flex-wrap items-center gap-2">
							if user.IsAdmin() {
								<a href="/settings/sources" class="btn btn-outline btn-sm gap-2 font-mono text-xs" title={ tr(ctx, "Change the TorrServer address in Settings → Sources") }>
									@Icon("hard-drive", "size-4 text-secondary")
									@torrActiveServer(engine)
								</a>
							} else {
								<span class="badge badge-outline gap-2 font-mono text-xs">
									@Icon("hard-drive", "size-4 text-secondary")
									@torrActiveServer(engine)
								</span>
							}
							<button
								type="button"
								data-on:click="@get('/api/torrserver/torrents')"
								class="btn btn-ghost btn-sm btn-circle"
								title={ tr(ctx, "Refresh torrents list") }
								aria-label={ tr(ctx, "Refresh torrents list") }
							>
								@Icon("refresh-cw", "size-4")
							</button>
							<button
								type="button"
								data-on:click="$addModalOpen = true"
								class="btn btn-primary btn-sm gap-2 shadow-md shadow-primary/20"
							>
								@Icon("plus", "size-4")
								{ tr(ctx, "Add Torrents") }
							</button>
						</div>
					</div>
					@torrStatus(echo)
				</div>
			</section>
			<div id="torr-alert-container"></div>
			@GStreamerLive(gst, true)
			@TorrServerGuide(echo, engine, gst.Can)
			<!-- Toolbar lives outside the streamed fragment so typing is never interrupted -->
			<section class="space-y-4" aria-labelledby="torr-list-title">
				@torrListToolbar(len(torrents))
				@streamKindsLegend()
				<!-- Stable wrapper: owns the SSE stream and the delegated action handler -->
				<div
					id="torr-list-stream-wrapper"
					data-init="@get('/api/torrserver/torrents?stream=true', {retry: 'always'})"
					data-on:click={ torrListActions(ctx) }
				>
					@TorrServerListFragment(links, torrents)
				</div>
			</section>
			@torrToast()
			@torrPlayerModal()
			@torrAddModal()
			@torrProbeModal()
			@torrFileMenu()
			@torrConfirmModal()
		</main>
	}
}

// TorrServerLiveFragment bundles every server-owned region of the page into one
// SSE patch; Datastar morphs each top-level element by id.
templ TorrServerLiveFragment(torrents []torrserver.Torrent, echo torrserver.EchoInfo, engine string, links StreamLinks, gstCan bool) {
	@torrStatus(echo)
	@TorrServerGuide(echo, engine, gstCan)
	@torrActiveServer(engine)
	@torrCount(len(torrents))
	@TorrServerListFragment(links, torrents)
}

templ torrActiveServer(engine string) {
	<span id="torr-active-server" class="truncate max-w-[140px] sm:max-w-[220px]">{ tr(ctx, engine) }</span>
}

templ torrCount(n int) {
	<span id="torr-count" class="badge badge-neutral font-mono text-xs">{ fmt.Sprint(n) }</span>
}

templ torrStatus(echo torrserver.EchoInfo) {
	<div id="torr-status" class="pt-4 border-t border-base-content/10 flex flex-wrap items-center gap-3 text-xs">
		if echo.Version != "" {
			<span class="badge badge-sm badge-soft badge-primary font-mono">{ echo.Version }</span>
		} else {
			<span class="badge badge-sm badge-soft badge-error font-mono">{ tr(ctx, "Offline") }</span>
		}
		if echo.GSTAvailable {
			<span class="flex items-center gap-1.5 text-success font-semibold">
				<span class="status status-success animate-pulse"></span>
				{ trf(ctx, "GStreamer v%s Active (HLS / Remux Ready)", echo.GSTVersion) }
			</span>
		} else {
			<span class="flex items-center gap-1.5 text-warning font-semibold">
				<span class="status status-warning"></span>
				{ tr(ctx, "GStreamer Inactive (Direct HTTP Streaming Only)") }
			</span>
		}
		if echo.Discoverer {
			<span class="badge badge-sm badge-soft badge-info">GST Discoverer</span>
		}
		if echo.HDRTonemap {
			<span class="badge badge-sm badge-soft badge-accent">{ tr(ctx, "HDR Tone Mapping") }</span>
		}
		<span class="text-base-content/50 ml-auto font-mono">{ tr(ctx, "Auto-updates via Datastar SSE") }</span>
	</div>
}

templ TorrServerListFragment(links StreamLinks, torrents []torrserver.Torrent) {
	<div id="torr-list-container" class="grid grid-cols-1 xl:grid-cols-2 gap-4">
		if len(torrents) == 0 {
			<div class="xl:col-span-2">
				@emptyState("film", tr(ctx, "No torrents added yet"), tr(ctx, "Add one or multiple torrents via HTTP/HTTPS download links or magnet URLs to stream directly in your browser.")) {
					<button type="button" data-on:click="$addModalOpen = true" class="btn btn-primary btn-sm gap-2">
						@Icon("plus", "size-4")
						{ tr(ctx, "Add First Torrent") }
					</button>
				}
			</div>
		} else {
			for _, t := range torrents {
				@torrentCard(links, t)
			}
		}
	</div>
}

templ torrentCard(links StreamLinks, t torrserver.Torrent) {
	{{
		name := t.DisplayName()
		videos := t.VideoFiles()
		videoCount := len(videos)
		page, pageLabel, pageIcon := titlePage(links, t.Hash)
	}}
	<article
		id={ "torr-card-" + t.Hash }
		class="@container card bg-base-200/80 border border-base-content/10 shadow-sm hover:shadow-md transition-shadow"
		data-name={ strings.ToLower(name) }
		data-show="!$filterQuery || el.dataset.name.includes($filterQuery.trim().toLowerCase())"
	>
		<div class="card-body p-4 sm:p-5 gap-3">
			<div class="flex flex-col @2xl:flex-row @2xl:items-center justify-between gap-4">
				<div class="flex items-start gap-4 min-w-0 grow">
					if t.Poster != "" {
						<img
							src={ t.Poster }
							alt=""
							class="w-16 h-24 rounded-field object-cover bg-base-300 shadow shrink-0"
							loading="lazy"
							decoding="async"
							width="64"
							height="96"
						/>
					} else {
						<span class="w-16 h-24 rounded-field bg-base-300 grid place-items-center text-base-content/40 shrink-0">
							@Icon("film", "size-8")
						</span>
					}
					<div class="space-y-1.5 min-w-0 grow">
						<h3 class="font-bold text-base sm:text-lg line-clamp-2 min-h-[2lh] leading-snug" title={ name }>
							if page != "" {
								<a href={ templ.SafeURL(page) } class="link link-hover">{ name }</a>
							} else {
								{ name }
							}
						</h3>
						<div class="flex flex-wrap items-center gap-2 text-xs">
							<span class="badge badge-sm badge-soft badge-primary font-mono">{ t.FormattedSize() }</span>
							<span class={ "badge badge-sm font-medium", t.StatusBadgeClass() }>{ tr(ctx, t.StatusLabel()) }</span>
							if t.Category != "" {
								<span class="badge badge-sm badge-ghost font-mono">{ t.Category }</span>
							}
							<span class="text-base-content/40 font-mono text-[11px] truncate max-w-[120px] sm:max-w-[200px]" title={ t.Hash }>{ t.Hash }</span>
						</div>
						<div class="stats stats-horizontal bg-base-100/90 border border-base-content/10 shadow-xs mt-2 w-full max-w-sm">
							@torrStat(tr(ctx, "Peers"), t.FormattedPeers(), "")
							@torrStat(tr(ctx, "Down"), t.FormattedDownloadSpeed(), "text-success")
							@torrStat(tr(ctx, "Up"), t.FormattedUploadSpeed(), "text-info")
						</div>
					</div>
				</div>
				<div class="flex flex-wrap items-center gap-2 shrink-0 self-end @2xl:self-center">
					if page != "" {
						<a href={ templ.SafeURL(page) } class="btn btn-ghost btn-sm btn-circle text-primary" title={ tr(ctx, pageLabel) } aria-label={ tr(ctx, pageLabel) }>
							@Icon(pageIcon, "size-4")
						</a>
					}
					<button
						type="button"
						data-action="copy"
						data-url={ t.MagnetLink() }
						data-msg={ tr(ctx, "Magnet link copied to clipboard") }
						class="btn btn-ghost btn-sm btn-circle text-accent"
						title={ tr(ctx, "Copy magnet link") }
						aria-label={ tr(ctx, "Copy magnet link") }
					>
						@Icon("magnet", "size-4")
					</button>
					if !t.GettingInfo() {
						<button
							type="button"
							data-action="drop"
							data-hash={ t.Hash }
							class="btn btn-ghost btn-sm btn-circle text-warning"
							title={ tr(ctx, "Drop active torrent cache") }
							aria-label={ tr(ctx, "Drop cache") }
						>
							@Icon("rotate-ccw", "size-4")
						</button>
					}
					<button
						type="button"
						data-action="remove"
						data-hash={ t.Hash }
						data-title={ name }
						data-show="$canRemove"
						class="btn btn-ghost btn-sm btn-circle text-error"
						title={ tr(ctx, "Remove from TorrServer") }
						aria-label={ tr(ctx, "Remove torrent") }
					>
						@Icon("trash-2", "size-4")
					</button>
				</div>
			</div>
			if len(t.FileStats) > 0 {
				<details
					id={ "torr-files-details-" + t.Hash }
					data-preserve-attr="open"
					open?={ videoCount <= 1 }
					class="collapse collapse-arrow bg-base-100/50 border border-base-content/10 mt-auto"
				>
					<summary class="collapse-title text-xs sm:text-sm font-semibold flex items-center gap-2 py-2.5 min-h-0">
						@Icon("folder", "size-4 text-primary")
						{ trf(ctx, "Torrent Files (%d)", len(t.FileStats)) }
						if videoCount > 0 {
							<span class="badge badge-xs badge-soft badge-primary font-mono">{ trn(ctx, videoCount, "%d video", "%d videos") }</span>
						}
					</summary>
					<div class="collapse-content text-sm">
						<ul class="divide-y divide-base-content/10">
							for _, f := range t.FileStats {
								@torrentFileRow(links, t.Hash, f)
							}
						</ul>
						<div class="mt-3 pt-3 border-t border-base-content/10 flex flex-wrap items-center justify-between gap-2 text-xs">
							if videoCount > 1 {
								<span class="text-base-content/70">{ trf(ctx, "All %d videos", videoCount) }</span>
							}
							<div class="flex flex-wrap items-center gap-2 ml-auto">
								if videoCount > 1 {
									<button
										type="button"
										data-action="play"
										data-kind="hls"
										{ playAttrs(t.Hash, videos[0].ID, videos[0].Path, links.Direct(t.Hash, videos[0]), links.HLS(t.Hash, videos[0]))... }
										class="btn btn-xs btn-primary gap-1.5"
										title={ tr(ctx, "Play every video here, one after the other") }
									>
										@Icon("list-video", "size-3")
										{ tr(ctx, "Play all") }
									</button>
									@playlistButton("direct", playlistPath(t.Hash, "direct"), links.Browser)
									@playlistButton("hls", playlistPath(t.Hash, "hls"), links.Browser)
								}
								<button
									type="button"
									data-action="files"
									data-hash={ t.Hash }
									class="btn btn-xs btn-ghost gap-1 text-primary font-mono"
									title={ tr(ctx, "Refetch files from TorrServer") }
								>
									@Icon("refresh-cw", "size-3")
									{ tr(ctx, "Refetch") }
								</button>
							</div>
						</div>
					</div>
				</details>
			} else {
				<div class="flex items-center justify-between text-xs text-base-content/70 bg-base-100/50 p-2.5 rounded-field border border-base-content/10 mt-auto">
					<span class="flex items-center gap-2 font-mono">
						@Icon("folder", "size-3.5 opacity-50")
						{ tr(ctx, "Files: not loaded") }
					</span>
					<button
						type="button"
						data-action="files"
						data-hash={ t.Hash }
						class="btn btn-xs btn-primary btn-outline font-mono gap-1"
					>
						@Icon("folder-search", "size-3.5")
						{ tr(ctx, "Fetch Files") }
					</button>
				</div>
			}
		</div>
	</article>
}

templ torrStat(title, value, tone string) {
	<div class="stat py-1.5 px-3">
		<div class="stat-title text-[10px] uppercase font-bold">{ title }</div>
		<div class={ "stat-value text-xs sm:text-sm font-mono font-semibold", tone }>{ value }</div>
	</div>
}

templ torrentFileRow(links StreamLinks, hash string, f torrserver.FileStat) {
	{{
		isVideo := torrserver.IsVideoFile(f.Path)
		clean := links.Direct(hash, f)
		hls := links.HLS(hash, f)
	}}
	<li class="py-2.5 flex flex-col @md:flex-row @md:items-center justify-between gap-2">
		<div class="min-w-0 flex items-center gap-2.5 grow">
			<span class="font-mono text-xs text-base-content/40 w-6 shrink-0 text-right">{ fmt.Sprint(f.ID) }.</span>
			<div class="min-w-0 grow">
				<div class="text-xs sm:text-sm font-medium truncate" title={ f.Path }>{ f.Path }</div>
				<div class="flex items-center gap-2 text-[11px] font-mono text-base-content/70">
					{ f.FormattedLength() }
					if isVideo {
						<span class="badge badge-xs badge-soft badge-primary">{ tr(ctx, "Video") }</span>
					}
				</div>
			</div>
		</div>
		<div class="flex items-center gap-1.5 shrink-0 self-end @md:self-center">
			if isVideo {
				{{ play := playAttrs(hash, f.ID, f.Path, clean, hls) }}
				@streamGroup("direct", play)
				@streamGroup("hls", play)
			}
			<button
				type="button"
				data-action="more"
				{ playAttrs(hash, f.ID, f.Path, clean, hls)... }
				data-video={ fmt.Sprint(isVideo) }
				class="btn btn-xs btn-ghost btn-square"
				aria-label={ tr(ctx, "More for this file") }
				title={ tr(ctx, "Open in VLC or IINA, copy links, inspect tracks") }
			>
				@Icon("ellipsis-vertical", "size-4")
			</button>
		</div>
	</li>
}

// modalDialog is a native <dialog> driven by a boolean signal: the effect opens
// it with showModal() (focus trap, Esc, top layer) and the close event keeps
// the signal in sync however the dialog was dismissed.
templ modalDialog(id, openSignal, onOpen, onClose, boxClass string, attrs templ.Attributes) {
	<dialog
		id={ id }
		class="modal"
		aria-labelledby={ id + "-title" }
		{ attrs... }
		data-effect={ fmt.Sprintf("if ($%s) { if (!el.open) { el.showModal(); %s } } else if (el.open) { el.close() }", openSignal, onOpen) }
		data-on:close={ fmt.Sprintf("$%s = false; %s", openSignal, onClose) }
	>
		<div class={ "modal-box bg-base-200 border border-base-content/10 shadow-2xl", boxClass }>
			{ children... }
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>{ tr(ctx, "close") }</button>
		</form>
	</dialog>
}

templ modalHeader(id, title, icon, iconTone string) {
	<header class="flex items-center justify-between gap-4 pb-3 border-b border-base-content/10">
		<h3 id={ id + "-title" } class="font-bold text-lg flex items-center gap-2 min-w-0">
			@Icon(icon, "size-5 "+iconTone)
			<span class="truncate">{ title }</span>
		</h3>
		<form method="dialog">
			<button class="btn btn-sm btn-circle btn-ghost" aria-label={ tr(ctx, "Close") }>
				@Icon("x", "size-4")
			</button>
		</form>
	</header>
}

templ torrToast() {
	<div
		popover="manual"
		role="status"
		aria-live="polite"
		class="toast toast-end toast-bottom m-0 inset-auto bottom-0 right-0 bg-transparent border-0 overflow-visible [&:not(:popover-open)]:hidden"
		data-effect="if ($toast) { el.matches(':popover-open') ? (el.hidePopover(), el.showPopover()) : el.showPopover() } else if (el.matches(':popover-open')) { el.hidePopover() }"
		data-on-signal-patch__debounce.3s={ toastAutoHide }
		data-on-signal-patch-filter="{ include: /^toast$/ }"
	>
		<div class="alert alert-success shadow-xl text-sm" data-class="{ 'alert-success': !$toastError, 'alert-error': $toastError }">
			<span class="contents" data-show="!$toastError">
				@Icon("circle-check", "size-4")
			</span>
			<span class="contents" data-show="$toastError">
				@Icon("triangle-alert", "size-4")
			</span>
			<span data-text="$toast"></span>
		</div>
	</div>
}

templ torrPlayerModal() {
	@torrPlayerModalFor(false)
}

// torrPlayerModalFor keeps one player UI; only transport hooks differ.
templ torrPlayerModalFor(browser bool) {
	@modalDialog("torr-player-modal", "playerOpen", "", "window.stopHlsVideo?.()", "max-w-5xl bg-base-300 p-4 sm:p-6", nil) {
		if browser {
			@webPlayerTransport()
		} else {
			<div class="hidden" data-effect={ torrPlayerStatsStream }></div>
			<div class="hidden" data-effect={ torrPlayback }></div>
			<div class="hidden" data-effect={ torrQueueFetch }></div>
		}
		<header class="flex items-center justify-between gap-4 pb-3 border-b border-base-content/10">
			<div class="flex items-center gap-2 min-w-0">
				@playKindSwitch(browser)
				<h3 id="torr-player-modal-title" class="font-bold text-base sm:text-lg truncate" data-text="$streamTitle">{ tr(ctx, "Streaming") }</h3>
			</div>
			<form method="dialog">
				<button class="btn btn-sm btn-circle btn-ghost" aria-label={ tr(ctx, "Close player") }>
					@Icon("x", "size-5")
				</button>
			</form>
		</header>
		<div
			class="relative mt-4 bg-black rounded-box overflow-hidden shadow-2xl aspect-video outline-none"
			tabindex="0"
			data-ref:_player
			data-on:pointermove="$_idle = false"
			data-on:pointermove__debounce.3s="$_idle = true"
			data-on:wheel={ torrWheelVolume }
			data-on:keydown__window={ torrPlayerKeys }
			data-on:fullscreenchange="$_fs = document.fullscreenElement === el"
			data-on-interval__duration.250ms="$_seekHint && Date.now() - $_seekAt > 700 && ($_seekHint = '')"
			data-class:cursor-none={ "!(" + torrControlsShown + ")" }
		>
			<video
				id="torr-video"
				playsinline
				class="size-full object-contain touch-manipulation"
				data-ref:_video
				data-on:click={ torrVideoClick }
				data-on:pointermove={ torrVideoZone }
				data-on:pointerdown={ torrVideoZone }
				data-on:pointerleave="$_zone = ''"
				data-on:dblclick={ torrVideoDoubleTap }
				data-on:play="$_paused = false"
				data-on:pause="$_paused = true"
				data-on:ended={ playerNext(browser) }
				data-on:waiting="$_waiting = true"
				data-on:playing="$_waiting = false"
				data-on:canplay="$_waiting = false"
				data-on:timeupdate="$_seeking || ($_time = el.currentTime)"
				data-on:durationchange="$_dur = Number.isFinite(el.duration) ? el.duration : 0"
				data-on:volumechange="$_vol = el.muted ? 0 : el.volume; $_muted = el.muted || el.volume === 0"
				data-on:emptied="$_time = 0; $_dur = 0; $_paused = true; $_waiting = false"
				data-on:torr-subtitle="$subTrack = evt.detail"
				data-on:torr-unplayable="$_unplayable = evt.detail"
				data-class:controls-shown={ torrControlsShown }
			></video>
			<span class="loading loading-spinner loading-lg text-primary absolute inset-0 m-auto pointer-events-none" data-show="$_waiting && !$_unplayable"></span>
			<!-- The browser refused the stream (player.js names the format it cannot decode). -->
			<div class="absolute inset-0 z-20 grid place-items-center p-6 bg-black/90" data-show="$_unplayable" role="alert">
				<div class="max-w-md text-center space-y-2 text-base-100">
					@Icon("circle-alert", "size-8 mx-auto text-warning")
					<p class="font-semibold">{ tr(ctx, "This browser cannot play") } <span data-text="$_unplayable"></span> { tr(ctx, "of this file.") }</p>
					<p class="text-sm opacity-80">{ tr(ctx, "Copy its Direct link below for VLC, another player or your TV, which play it as it is.") }</p>
				</div>
			</div>
			<!--
				What each third of the video does: hovering (or touching) shows it,
				a double tap there skips and the hint shows the skip, adding up taps.
			-->
			@seekZoneHint("back")
			<div class="absolute inset-y-0 left-1/3 w-1/3 grid place-items-center pointer-events-none">
				<span
					class="size-16 rounded-full bg-base-content/50 text-base-100 grid place-items-center transition-opacity"
					aria-hidden="true"
					data-show="$_paused || ($_zone === 'center' && !$_idle)"
				>
					<span class="contents" data-show="$_paused">
						@Icon("play", "size-8 translate-x-0.5")
					</span>
					<span class="contents" data-show="!$_paused">
						@Icon("pause", "size-8")
					</span>
				</span>
			</div>
			@seekZoneHint("fwd")
			<!-- In fullscreen the header is gone: the title (and place in the playlist) shows over the video. -->
			<div
				class="absolute inset-x-0 top-0 z-10 bg-linear-to-b from-primary/90 to-transparent px-4 pt-3 pb-10 text-primary-content transition-opacity pointer-events-none"
				data-show="$_fs"
				data-class:opacity-0={ "!(" + torrControlsShown + ")" }
			>
				<p class="font-semibold truncate">
					<span data-text="$streamTitle"></span>
					<span class="font-mono text-sm opacity-80" data-show={ torrQueueAt + " >= 0 && $_queue.length > 1" } data-text={ "' · ' + (" + torrQueueAt + " + 1) + ' / ' + $_queue.length" }></span>
				</p>
			</div>
			<!-- Custom control bar: native controls would hide these menus in fullscreen -->
			<div
				class="absolute inset-x-0 bottom-0 z-10 bg-linear-to-t from-primary/90 to-transparent px-3 pb-2 pt-10 text-primary-content transition-opacity"
				data-class:opacity-0={ "!(" + torrControlsShown + ")" }
				data-class:pointer-events-none={ "!(" + torrControlsShown + ")" }
			>
				<input
					type="range"
					class="range range-xs w-full"
					aria-label={ tr(ctx, "Seek") }
					min="0"
					step="0.1"
					data-attr:max="$_dur || 0"
					data-bind:_time
					data-on:pointerdown="$_seeking = true"
					data-on:change="$_video.currentTime = +el.value; $_seeking = false"
				/>
				<div class="mt-1 flex items-center gap-1">
					<button type="button" class="btn btn-ghost btn-sm btn-square text-primary-content" aria-label={ tr(ctx, "Play or pause") } data-on:click="$_video.paused ? $_video.play() : $_video.pause()">
						<span data-show="$_paused">
							@Icon("play", "size-5")
						</span>
						<span data-show="!$_paused">
							@Icon("pause", "size-5")
						</span>
					</button>
					<button
						type="button"
						class="btn btn-ghost btn-sm btn-square text-primary-content"
						aria-label={ tr(ctx, "Next file") }
						title={ tr(ctx, "Next file") }
						data-show={ torrHasNext }
						data-on:click={ playerNext(browser) }
					>
						@Icon("skip-forward", "size-5")
					</button>
					<button type="button" class="btn btn-ghost btn-sm btn-square text-primary-content" aria-label={ tr(ctx, "Mute") } data-on:click="$_video.muted = !$_video.muted">
						<span data-show="!$_muted">
							@Icon("volume-2", "size-5")
						</span>
						<span data-show="$_muted">
							@Icon("volume-x", "size-5")
						</span>
					</button>
					<input
						type="range"
						class="range range-xs w-20 hidden sm:block"
						aria-label={ tr(ctx, "Volume") }
						min="0"
						max="1"
						step="0.05"
						data-bind:_vol
						data-on:input="$_video.volume = +el.value; $_video.muted = false"
					/>
					<span class="ml-2 font-mono text-xs tabular-nums" data-text={ torrTimeText }>0:00 / 0:00</span>
					<div class="grow"></div>
					<span class="contents" data-show="$playKind === 'hls' && $audioTrack >= 0">
						@playerSlot("ts-player-audio", browser) {
							@TorrAudioPicker(nil, 0)
						}
					</span>
					@playerSlot("ts-player-subtitles", browser) {
						@TorrSubtitleMenu(nil)
					}
					@playerSlot("ts-player-playlist", browser) {
						@TorrPlaylist(nil, browser)
					}
					<button
						type="button"
						class="btn btn-ghost btn-sm btn-square text-primary-content"
						aria-label={ tr(ctx, "Picture in picture") }
						data-show="document.pictureInPictureEnabled"
						data-on:click="document.pictureInPictureElement ? document.exitPictureInPicture() : $_video.requestPictureInPicture()"
					>
						@Icon("picture-in-picture-2", "size-5")
					</button>
					<button type="button" class="btn btn-ghost btn-sm btn-square text-primary-content" aria-label={ tr(ctx, "Fullscreen") } data-on:click={ torrFullscreenToggle }>
						<span data-show="!$_fs">
							@Icon("maximize", "size-5")
						</span>
						<span data-show="$_fs">
							@Icon("minimize", "size-5")
						</span>
					</button>
				</div>
			</div>
		</div>
		if browser {
			@webPlayerProblems()
		}
		<div id="torr-player-stats" class="mt-3 flex flex-wrap items-center gap-2"></div>
		<div data-show="$playKind === 'hls' && $mediaInfoOpen">
			@playerSlot("ts-player-media-info", browser) {
				<div id="torr-media-info"></div>
			}
		</div>
		<div class="mt-4 flex flex-wrap items-center gap-2 pt-3 border-t border-base-content/10">
			<div role="group" aria-label={ tr(ctx, "Direct: the original file") } class="w-full flex flex-wrap items-center gap-2" data-show="$streamCleanUrl">
				<span class="badge badge-sm badge-primary badge-soft font-bold w-14 justify-center">{ tr(ctx, "Direct") }</span>
				<button type="button" data-on:click={ "window.copyLink($streamCleanUrl, $linkOrigin).then(ok => { $toastError = !ok; $toast = ok ? " + trJS(ctx, "Direct link copied") + " : " + trJS(ctx, "Copy failed") + " })" } class="btn btn-xs btn-outline btn-primary gap-1.5">
					@Icon("link", "size-3.5")
					{ tr(ctx, "Copy link") }
				</button>
				<a
					data-attr:href="'/api/torrserver/playlist?hash=' + encodeURIComponent($activeHash) + '&kind=direct'"
					if browser {
						data-on:click__prevent="tsDownloadPlaylist($_session, $tsSelected, $activeHash, 'direct')"
					}
					download
					class="btn btn-xs btn-outline btn-primary gap-1.5"
				>
					@Icon("download", "size-3.5")
					.m3u8
				</a>
				<button type="button" data-on:click={ openPlayer(ctx, "vlc", "VLC", "$streamCleanUrl") } class="btn btn-xs btn-outline btn-primary gap-1.5" title={ trf(ctx, "Open the original file in %s", "VLC") }>
					@Icon("external-link", "size-3.5")
					VLC
				</button>
				<button type="button" data-on:click={ openPlayer(ctx, "iina", "IINA", "$streamCleanUrl") } data-show={ onMac } class="btn btn-xs btn-outline btn-primary gap-1.5" title={ trf(ctx, "Open the original file in %s", "IINA") }>
					@Icon("external-link", "size-3.5")
					IINA
				</button>
				<span class="text-xs text-base-content/70">{ tr(ctx, "The original file, full quality. For VLC and other players, and TVs.") }</span>
				@vlcNote()
			</div>
			<div role="group" aria-label={ tr(ctx, "HLS: converted by GStreamer") } class="w-full flex flex-wrap items-center gap-2" data-show="$gst">
				<span class="badge badge-sm badge-secondary badge-soft font-bold w-14 justify-center">HLS</span>
				<button type="button" data-on:click={ "window.copyLink($streamHlsUrl, $linkOrigin).then(ok => { $toastError = !ok; $toast = ok ? " + trJS(ctx, "HLS link copied") + " : " + trJS(ctx, "Copy failed") + " })" } class="btn btn-xs btn-outline btn-secondary gap-1.5">
					@Icon("link", "size-3.5")
					{ tr(ctx, "Copy link") }
				</button>
				<a
					data-attr:href="'/api/torrserver/playlist?hash=' + encodeURIComponent($activeHash) + '&kind=hls'"
					if browser {
						data-on:click__prevent="tsDownloadPlaylist($_session, $tsSelected, $activeHash, 'hls')"
					}
					download
					class="btn btn-xs btn-outline btn-secondary gap-1.5"
				>
					@Icon("download", "size-3.5")
					.m3u8
				</a>
				<span class="text-xs text-base-content/70">{ tr(ctx, "Converted by GStreamer as it plays. Plays in any browser, on phones and TVs.") }</span>
			</div>
			<div class="w-full flex flex-wrap items-center gap-2 pt-2 border-t border-base-content/10" data-show="$gst">
				<button
					type="button"
					data-show="$gst"
					data-on:click="$probeHash = $activeHash; $probeIndex = $activeFileIndex; $probeOpen = true"
					class="btn btn-xs btn-ghost gap-1.5 text-info"
					title={ tr(ctx, "Inspect media codecs, audio streams, and subtitle tracks") }
				>
					@Icon("info", "size-3.5")
					{ tr(ctx, "Inspect Tracks") }
				</button>
				<button
					type="button"
					data-show="$gst"
					data-on:click="$mediaInfoOpen = !$mediaInfoOpen"
					data-class:btn-active="$mediaInfoOpen"
					class="btn btn-xs btn-ghost gap-1.5"
					title={ tr(ctx, "Compare the source file with the HLS stream") }
				>
					@Icon("film", "size-3.5")
					{ tr(ctx, "Media Info") }
				</button>
			</div>
		</div>
	}
}

templ torrAddModal(browser ...bool) {
	{{ cloud := len(browser) > 0 && browser[0] }}
	@modalDialog("torr-add-modal", "addModalOpen", "", "", "max-w-xl", nil) {
		@modalHeader("torr-add-modal", tr(ctx, "Add Torrents"), "plus", "text-primary")
		@TorrAddForm(cloud)
	}
}

// TorrAddForm adds torrents from links and .torrent files. Datastar sends it
// as a multipart form, files included.
templ TorrAddForm(browser ...bool) {
	{{
		cloud := len(browser) > 0 && browser[0]
		busy := "$adding"
		if cloud {
			busy = "$_tsAddResult.adding"
		}
	}}
	<form
		id="torr-add-form"
		action="/api/torrserver/add"
		method="POST"
		enctype="multipart/form-data"
		class="mt-4"
		{ torrentAddTransport(cloud)... }
	>
		<fieldset class="fieldset gap-4" data-attr:disabled={ busy }>
			<legend class="sr-only">{ tr(ctx, "New torrents") }</legend>
			<label class="flex flex-col gap-1.5">
				<span class="label justify-between font-semibold text-sm text-base-content">
					{ tr(ctx, "Links") }
					<span class="text-xs font-normal text-base-content/70">{ tr(ctx, "One per line") }</span>
				</span>
				<textarea
					name="addLinks"
					rows="4"
					class="textarea w-full font-mono text-xs"
					placeholder="magnet:?xt=urn:btih:…&#10;https://tracker.example/file.torrent"
				></textarea>
				<span class="text-xs text-base-content/70">{ tr(ctx, "Magnet links, http(s) links to .torrent files, torrs:// links or info-hashes") }</span>
			</label>
			<label class="flex flex-col gap-1.5">
				<span class="label justify-between font-semibold text-sm text-base-content">
					{ tr(ctx, ".torrent files") }
					<span class="text-xs font-normal text-base-content/70">{ tr(ctx, "Up to 20") }</span>
				</span>
				<input id="torr-add-files" type="file" name="addFiles" multiple accept=".torrent,application/x-bittorrent" class="file-input w-full"/>
			</label>
			<label class="flex flex-col gap-1.5">
				<span class="label justify-between font-semibold text-sm text-base-content">
					{ tr(ctx, "Custom title") }
					<span class="text-xs font-normal text-base-content/70">{ tr(ctx, "Optional, single torrent only") }</span>
				</span>
				<input
					type="text"
					name="addTitle"
					class="input w-full text-sm"
					placeholder={ tr(ctx, "e.g. Inception (2010)") }
				/>
			</label>
			<div class="modal-action mt-2 pt-3 border-t border-base-content/10">
				<button type="button" data-on:click="$addModalOpen = false" class="btn btn-sm btn-ghost">{ tr(ctx, "Cancel") }</button>
				<button type="submit" class="btn btn-sm btn-primary">
					<span class="loading loading-spinner loading-xs hidden" data-class:hidden={ "!" + busy }></span>
					{ tr(ctx, "Add to TorrServer") }
				</button>
			</div>
		</fieldset>
		<div id="torr-add-result"></div>
	</form>
}

templ torrProbeModal() {
	@torrProbeModalFor(false)
}

templ torrProbeModalFor(browser bool) {
	@modalDialog("torr-probe-modal", "probeOpen", probeOpenAction(browser), "", "max-w-2xl", templ.Attributes{"data-indicator:probe-loading": true}) {
		if browser {
			@webProbeTransport()
		}
		@modalHeader("torr-probe-modal", tr(ctx, "GStreamer Media Analysis"), "info", "text-info")
		<div class="mt-4 flex justify-center p-8 hidden" data-class:hidden="!$probeLoading">
			<span class="loading loading-spinner text-info" aria-label={ tr(ctx, "Loading") }></span>
		</div>
		<div data-class:hidden="$probeLoading">
			<div id="torr-probe-content"></div>
		</div>
	}
}

// vlcNote says what opening VLC from a browser needs.
templ vlcNote() {
	<p class="w-full flex items-start gap-1.5 text-xs text-base-content/70">
		@Icon("info", "size-3.5 shrink-0 mt-0.5 text-info")
		<span>
			{ tr(ctx, "VLC must be installed. On Windows and Mac, the browser also needs the vlc-protocol handler, installed once:") }
			<a class="link link-primary" href="https://github.com/northsea4/vlc-protocol" target="_blank" rel="noopener noreferrer">vlc-protocol</a>
		</span>
	</p>
}

// copyFileLink copies one of the open file menu's links and closes the menu.
func copyFileLink(ctx context.Context, link, copied string) string {
	return "$fileMenuOpen = false; window.copyLink(" + link + ", $linkOrigin).then(ok => { $toastError = !ok; $toast = ok ? " + trJS(ctx, copied) + " : " + trJS(ctx, "Copy failed") + " })"
}

// torrFileMenu is a file row's menu ($_file): external players, its links
// and its tracks, kept off the row so the list stays compact.
templ torrFileMenu() {
	@modalDialog("torr-file-menu", "fileMenuOpen", "", "", "max-w-md", nil) {
		<header class="flex items-center justify-between gap-4 pb-3 border-b border-base-content/10">
			<h3 id="torr-file-menu-title" class="font-bold flex items-center gap-2 min-w-0">
				@Icon("file-video", "size-5 shrink-0 text-primary")
				<span class="break-all text-sm" data-text="$_file.title"></span>
			</h3>
			<form method="dialog">
				<button class="btn btn-sm btn-circle btn-ghost" aria-label={ tr(ctx, "Close") }>
					@Icon("x", "size-4")
				</button>
			</form>
		</header>
		<section class="mt-4 space-y-2" data-show="$_file.video">
			<h4 class="text-xs font-bold uppercase tracking-wider text-base-content/70">{ tr(ctx, "Open in a player") }</h4>
			<div class="flex flex-wrap items-center gap-2">
				<button type="button" data-on:click={ "$fileMenuOpen = false; " + openPlayer(ctx, "vlc", "VLC", "$_file.clean") } class="btn btn-sm btn-outline btn-primary gap-1.5" title={ trf(ctx, "Open the original file in %s", "VLC") }>
					@Icon("external-link", "size-4")
					VLC
				</button>
				<button type="button" data-on:click={ "$fileMenuOpen = false; " + openPlayer(ctx, "iina", "IINA", "$_file.clean") } data-show={ onMac } class="btn btn-sm btn-outline btn-primary gap-1.5" title={ trf(ctx, "Open the original file in %s", "IINA") }>
					@Icon("external-link", "size-4")
					IINA
				</button>
			</div>
			@vlcNote()
		</section>
		<section class="mt-5 space-y-2">
			<h4 class="text-xs font-bold uppercase tracking-wider text-base-content/70">{ tr(ctx, "Links") }</h4>
			<div class="flex flex-wrap items-center gap-2">
				<button type="button" data-on:click={ copyFileLink(ctx, "$_file.clean", "Direct link copied") } class="btn btn-sm btn-outline btn-primary gap-1.5">
					@Icon("link", "size-4")
					{ tr(ctx, "Copy Direct link") }
				</button>
				<button type="button" data-show="$gst && $_file.video" data-on:click={ copyFileLink(ctx, "$_file.hls", "HLS link copied") } class="btn btn-sm btn-outline btn-secondary gap-1.5">
					@Icon("link", "size-4")
					{ tr(ctx, "Copy HLS link") }
				</button>
			</div>
		</section>
		<button type="button" data-show="$gst && $_file.video" data-on:click="$fileMenuOpen = false; $probeHash = $_file.hash; $probeIndex = $_file.index; $probeOpen = true" class="btn btn-sm btn-ghost text-info gap-1.5 mt-4">
			@Icon("info", "size-4")
			{ tr(ctx, "Inspect tracks") }
		</button>
	}
}

templ torrConfirmModal() {
	@torrConfirmModalFor(false)
}

templ torrConfirmModalFor(browser bool) {
	@modalDialog("torr-confirm-modal", "confirmOpen", "", "", "max-w-md", nil) {
		@modalHeader("torr-confirm-modal", tr(ctx, "Remove torrent?"), "trash-2", "text-error")
		<p class="mt-4 text-sm">
			<span class="font-semibold break-all" data-text="$confirmName"></span>
			{ tr(ctx, "will be removed from the TorrServer database. This cannot be undone.") }
		</p>
		<div class="modal-action">
			<form method="dialog">
				<button class="btn btn-sm btn-ghost">{ tr(ctx, "Cancel") }</button>
			</form>
			<button
				type="button"
				data-on:click={ confirmRemove(browser) }
				class="btn btn-sm btn-error"
			>
				@Icon("trash-2", "size-4")
				{ tr(ctx, "Remove") }
			</button>
		</div>
	}
}

templ TorrServerProbeFragment(res *torrserver.ProbeResult) {
	<div id="torr-probe-content" class="mt-4 space-y-4">
		<dl class="bg-base-100 p-4 rounded-box border border-base-content/10 flex flex-wrap items-center justify-between gap-3 font-mono text-xs">
			<div><dt class="inline text-base-content/70">{ tr(ctx, "Container:") } </dt><dd class="inline font-bold text-primary">{ res.Container }</dd></div>
			<div><dt class="inline text-base-content/70">{ tr(ctx, "Duration:") } </dt><dd class="inline font-bold text-accent">{ res.DurationFormatted() }</dd></div>
			<div><dt class="inline text-base-content/70">{ tr(ctx, "Size:") } </dt><dd class="inline font-bold">{ torrserver.FormatBytes(res.FileSize) }</dd></div>
		</dl>
		<div class="space-y-2">
			<h4 class="text-xs font-bold uppercase tracking-wider text-base-content/70">{ tr(ctx, "Discovered Media Tracks") }</h4>
			<ul class="space-y-2">
				for _, trk := range res.Tracks {
					<li class="p-3 rounded-box bg-base-100 border border-base-content/10 flex items-start justify-between gap-3 text-xs">
						<div class="flex items-start gap-2.5 min-w-0">
							switch trk.Type {
								case "video":
									<span class="badge badge-sm badge-primary font-mono uppercase">{ tr(ctx, "Video") }</span>
								case "audio":
									<span class="badge badge-sm badge-secondary font-mono uppercase">{ tr(ctx, "Audio") }</span>
								default:
									<span class="badge badge-sm badge-neutral font-mono uppercase">{ tr(ctx, "Subtitle") }</span>
							}
							<div class="min-w-0 space-y-1">
								<div class="font-semibold break-words">
									if trk.Title != "" {
										{ trk.Title }
									} else {
										{ trk.CapsName }
									}
								</div>
								<div class="text-[11px] text-base-content/70 font-mono">{ trackDetails(ctx, trk) }</div>
								if caps := trackCaps(trk.Codec); caps != "" {
									<p class="text-[11px] text-base-content/50 font-mono break-all whitespace-normal">{ caps }</p>
								}
							</div>
						</div>
						<span class="badge badge-xs badge-ghost font-mono">#{ fmt.Sprint(trk.Index) }</span>
					</li>
				}
			</ul>
		</div>
	</div>
}

templ TorrServerProbeError(msg string) {
	<div id="torr-probe-content" class="mt-4">
		<div role="alert" class="alert alert-warning alert-soft text-sm">
			@Icon("circle-alert", "size-4")
			<span>{ msg }</span>
		</div>
	</div>
}

// TorrMediaInfo compares the source file with what the HLS stream delivers.
templ TorrMediaInfo(probe *torrserver.ProbeResult, audioIndex int, output *torrserver.HLSOutput) {
	<div id="torr-media-info" class="mt-3 overflow-x-auto rounded-box border border-base-content/10 bg-base-200">
		if probe == nil {
			<p class="p-3 text-xs text-base-content/70">{ tr(ctx, "Media info unavailable — the file may still be buffering.") }</p>
		} else {
			<table class="table table-xs font-mono">
				<thead>
					<tr>
						<th></th>
						<th>{ tr(ctx, "Source") }</th>
						<th>{ tr(ctx, "HLS output") }</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range newMediaInfo(probe, audioIndex, output).Rows {
						<tr>
							<th class="font-sans text-base-content/70">{ tr(ctx, row.Label) }</th>
							<td>{ row.Source }</td>
							<td class={ row.OutputTone }>{ tr(ctx, row.Output) }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

// TorrPlayerStats is the compact live stats row under the video.
templ TorrPlayerStats(t *torrserver.Torrent, cacheSize int64) {
	<div id="torr-player-stats" class="mt-3 flex flex-wrap items-center gap-2">
		if t == nil {
			<span class="badge badge-sm badge-ghost font-mono">{ tr(ctx, "Stats unavailable") }</span>
		} else {
			<span class="badge badge-sm badge-ghost font-mono gap-1" title={ tr(ctx, "Active / total peers") }>
				@Icon("users", "size-3.5")
				{ trf(ctx, "Peers %d/%d", t.ActivePeers, max(t.ActivePeers, t.TotalPeers)) }
			</span>
			<span class="badge badge-sm badge-ghost font-mono gap-1" title={ tr(ctx, "Connected seeders") }>
				@Icon("sprout", "size-3.5")
				{ trf(ctx, "Seeds %d", t.Connected) }
			</span>
			<span class="badge badge-sm badge-ghost font-mono gap-1" title={ tr(ctx, "Download speed") }>
				@Icon("arrow-down", "size-3.5")
				{ t.FormattedDownloadSpeed() }
			</span>
			if cacheSize > 0 {
				<span class={ "badge badge-sm font-mono gap-1", bufferBadgeTone(t.BufferPercent(cacheSize)) } title={ tr(ctx, "TorrServer read-ahead cache fill") }>
					@Icon("database", "size-3.5")
					{ trf(ctx, "Buffer %d%%", t.BufferPercent(cacheSize)) }
				</span>
			}
		}
	</div>
}

// bufferBadgeTone warns when the read-ahead cache is running low.
func bufferBadgeTone(pct int) string {
	switch {
	case pct >= 50:
		return "badge-success badge-soft"
	case pct >= 15:
		return "badge-warning badge-soft"
	default:
		return "badge-error badge-soft"
	}
}

// torrSubtitlePick drives hls.js; the video's torr-subtitle event reports the
// active track back into $subTrack, whichever control (this menu or the
// keyboard/native text tracks) changed it.
const torrSubtitlePick = `const b = evt.target.closest('[data-track]')
if (b) { $_subMenu = false; window.setSubtitleTrack(+b.dataset.track) }`

// TorrSubtitleMenu is the subtitles menu in the player's control bar.
templ TorrSubtitleMenu(tracks []torrserver.ProbeTrack) {
	<div id="torr-subtitle-menu" class="contents">
		if len(tracks) > 0 {
			@trackMenu(tr(ctx, "Subtitles"), "captions", "$_subMenu", "$_subMenu = !$_subMenu; $_audioMenu = false", "$subTrack >= 0", torrSubtitlePick) {
				<li>
					<button type="button" data-track="-1" data-class:menu-active="$subTrack < 0">{ tr(ctx, "Off") }</button>
				</li>
				for _, trk := range tracks {
					<li>
						<button type="button" data-track={ fmt.Sprint(trk.Index) } data-class:menu-active={ fmt.Sprintf("$subTrack === %d", trk.Index) }>{ trackLabel(ctx, trk) }</button>
					</li>
				}
			}
		}
	</div>
}

// trackMenu is an upward-opening dropdown in the control bar. openSignal
// drives it so picking an item (or clicking outside) closes it; highlight
// tints the icon (e.g. while subtitles are on).
templ trackMenu(title, icon, openSignal, toggle, highlight, pick string) {
	<details class="dropdown dropdown-top dropdown-end" data-attr:open={ openSignal } data-on:click__outside={ openSignal + " = false" }>
		<summary
			class="btn btn-ghost btn-sm btn-square text-primary-content"
			aria-label={ title }
			title={ title }
			data-class:text-primary={ highlight }
			data-on:click__prevent={ toggle }
		>
			@Icon(icon, "size-5")
		</summary>
		<ul class="dropdown-content menu menu-sm bg-base-200 text-base-content rounded-box w-56 p-2 mb-2 shadow-lg font-mono" data-on:click={ pick }>
			<li class="menu-title">{ title }</li>
			{ children... }
		</ul>
	</details>
}

// torrAudioPick switches the audio track (restarting the HLS stream on it)
// and remembers its language for the next file.
const torrAudioPick = `const b = evt.target.closest('[data-track]')
if (b) {
	$audioTrack = +b.dataset.track; $audioLang = b.dataset.lang; $_audioMenu = false
	localStorage.setItem('torrAudioLang', $audioLang)
}`

// TorrAudioPicker is the audio menu in the player's control bar. It is only
// shown when the file has more than one audio track.
templ TorrAudioPicker(tracks []torrserver.ProbeTrack, selected int) {
	<div id="torr-audio-picker" class="contents">
		if len(tracks) > 1 {
			@trackMenu(tr(ctx, "Audio"), "audio-lines", "$_audioMenu", "$_audioMenu = !$_audioMenu; $_subMenu = false", "false", torrAudioPick) {
				for _, trk := range tracks {
					<li>
						<button type="button" data-track={ fmt.Sprint(trk.Index) } data-lang={ trk.Language } data-class:menu-active={ fmt.Sprintf("$audioTrack === %d", trk.Index) }>{ trackLabel(ctx, trk) }</button>
					</li>
				}
			}
		}
	</div>
}

// TorrPlaylist is the playlist menu in the player's control bar: the
// torrent's videos, shown when there is more than one.
templ TorrPlaylist(videos []torrserver.FileStat, browser ...bool) {
	{{
		pick := torrPlaylistPick
		if len(browser) > 0 && browser[0] {
			pick = webPlaylistPick()
		}
	}}
	<div id="torr-playlist" class="contents">
		if len(videos) > 1 {
			@trackMenu(tr(ctx, "Playlist"), "list-video", "$_listMenu", "$_listMenu = !$_listMenu; $_audioMenu = false; $_subMenu = false", "false", pick) {
				for i, f := range videos {
					<li>
						<button type="button" data-at={ fmt.Sprint(i) } data-class:menu-active={ fmt.Sprintf("$activeFileIndex === %d", f.ID) } title={ f.Path }>
							<span class="truncate">{ fmt.Sprintf("%d. %s", i+1, path.Base(f.Path)) }</span>
						</button>
					</li>
				}
			}
		}
	</div>
}

// trackLabel renders "EN · Original · 5.1" for the audio and subtitle pickers.
func trackLabel(ctx context.Context, trk torrserver.ProbeTrack) string {
	var parts []string
	if trk.Language != "" {
		parts = append(parts, strings.ToUpper(trk.Language))
	}
	if trk.Title != "" {
		parts = append(parts, trk.Title)
	}
	switch trk.Channels {
	case 0:
	case 1:
		parts = append(parts, tr(ctx, "Mono"))
	case 2:
		parts = append(parts, tr(ctx, "Stereo"))
	case 6:
		parts = append(parts, "5.1")
	case 8:
		parts = append(parts, "7.1")
	default:
		parts = append(parts, trf(ctx, "%d ch", trk.Channels))
	}
	if len(parts) == 0 {
		return trf(ctx, "Track %d", trk.Index+1)
	}
	return strings.Join(parts, " · ")
}

func trackDetails(ctx context.Context, trk torrserver.ProbeTrack) string {
	parts := []string{trk.CapsName}
	if trk.Language != "" {
		parts = append(parts, trk.Language)
	}
	if trk.Width > 0 && trk.Height > 0 {
		parts = append(parts, fmt.Sprintf("%dx%d", trk.Width, trk.Height))
	}
	if trk.Channels > 0 {
		parts = append(parts, trf(ctx, "%d ch", trk.Channels))
	}
	return strings.Join(parts, " • ")
}

// TorrServerAlertFragment replaces the alert region. A fresh element id per
// render makes Datastar re-initialise the alert (and its $torrAlert signal).
templ TorrServerAlertFragment(msg, alertType string, container ...string) {
	{{ id := "torr-alert-container"
if len(container) > 0 {
	id = container[0]
} }}
	<div id={ id }>
		if msg != "" {
			<div
				id={ fmt.Sprintf("torr-alert-%d", time.Now().UnixNano()) }
				role="alert"
				class={ "alert alert-soft", alertClass(alertType) }
				data-signals="{ torrAlert: true }"
				data-show="$torrAlert"
			>
				if alertType == "success" {
					@Icon("circle-check", "size-5")
				} else {
					@Icon("circle-alert", "size-5")
				}
				<span class="text-sm font-medium grow">{ msg }</span>
				<button
					type="button"
					data-on:click="$torrAlert = false"
					class="btn btn-xs btn-ghost btn-circle"
					aria-label={ tr(ctx, "Dismiss") }
				>
					@Icon("x", "size-4")
				</button>
			</div>
		}
	</div>
}

// alertClass maps an alert type to a literal DaisyUI class (kept literal so
// Tailwind's source scanner includes it in the build).
func alertClass(alertType string) string {
	switch alertType {
	case "success":
		return "alert-success"
	case "error":
		return "alert-error"
	case "warning":
		return "alert-warning"
	default:
		return "alert-info"
	}
}

// streamKindsLegend explains, once above the list, the two ways to watch
// that every file and the player offer.
templ streamKindsLegend() {
	<div id="stream-kinds" class="grid gap-3 sm:grid-cols-2">
		@streamKind(tr(ctx, "Direct"), tr(ctx, "The original file"), tr(ctx, "The original file, full quality. For VLC and other players, and TVs."), "file-play", false)
		<div class="contents" data-show="$gst">
			@streamKind("HLS", tr(ctx, "Converted as it plays"), tr(ctx, "Converted by GStreamer as it plays. Plays in any browser, on phones and TVs."), "monitor-play", true)
		</div>
	</div>
}

templ streamKind(label, title, text, icon string, hls bool) {
	<div class={ "flex items-start gap-3 rounded-box border p-3", templ.KV("border-primary/30 bg-primary/5", !hls), templ.KV("border-secondary/30 bg-secondary/5", hls) }>
		<span class={ "size-9 shrink-0 rounded-field grid place-items-center", templ.KV("bg-primary text-primary-content", !hls), templ.KV("bg-secondary text-secondary-content", hls) }>
			@Icon(icon, "size-5")
		</span>
		<div class="min-w-0">
			<p class="text-sm font-bold">
				<span class={ "uppercase tracking-wide", templ.KV("text-primary", !hls), templ.KV("text-secondary", hls) }>{ label }</span>
				<span class="font-medium text-base-content/70">· { title }</span>
			</p>
			<p class="text-xs text-base-content/70">{ text }</p>
		</div>
	</div>
}

// streamGroup plays a file one way, labelled and coloured the same
// everywhere: Direct (primary) or HLS (secondary, only with GStreamer).
templ streamGroup(kind string, play templ.Attributes) {
	{{
		hls := kind == "hls"
		label, aria := tr(ctx, "Direct"), tr(ctx, "Direct: the original file")
		playHelp := tr(ctx, "Play the original file here. Browsers can't play every format: if it stays black or silent, use HLS or VLC")
		if hls {
			label, aria = "HLS", tr(ctx, "HLS: converted by GStreamer")
			playHelp = tr(ctx, "Play here, converted by GStreamer: works in every browser, picks audio tracks")
		}
	}}
	<div
		role="group"
		aria-label={ aria }
		if hls {
			data-show="$gst"
		}
		class={ "flex items-center rounded-field border",
			templ.KV("border-primary/30 bg-primary/5", !hls), templ.KV("border-secondary/30 bg-secondary/5", hls) }
	>
		<span class={ "pl-2 pr-1 text-[9px] font-bold uppercase tracking-wide", templ.KV("text-primary", !hls), templ.KV("text-secondary", hls) }>{ label }</span>
		<button
			type="button"
			data-action="play"
			data-kind={ kind }
			{ play... }
			class={ "btn btn-xs btn-square shadow-none", templ.KV("btn-primary", !hls), templ.KV("btn-secondary", hls) }
			aria-label={ trf(ctx, "Play %s", label) }
			title={ playHelp }
		>
			@Icon("play", "size-3.5")
		</button>
	</div>
}

// playlistButton downloads the playlist of all files, Direct or HLS.
templ playlistButton(kind, href string, browser ...bool) {
	{{ cloud := len(browser) > 0 && browser[0] }}
	if kind == "hls" {
		<a
			href={ templ.SafeURL(href) }
			download
			if cloud {
				data-action="playlist"
				data-kind={ kind }
				data-url={ href }
			}
			data-show="$gst"
			aria-label={ tr(ctx, "HLS: converted by GStreamer") }
			class="btn btn-xs btn-outline btn-secondary gap-1.5"
		>
			@Icon("download", "size-3")
			HLS .m3u8
		</a>
	} else {
		<a
			href={ templ.SafeURL(href) }
			download
			if cloud {
				data-action="playlist"
				data-kind={ kind }
				data-url={ href }
			}
			aria-label={ tr(ctx, "Direct: the original file") }
			class="btn btn-xs btn-outline btn-primary gap-1.5"
		>
			@Icon("download", "size-3")
			{ tr(ctx, "Direct") } .m3u8
		</a>
	}
}

// seekZoneHint is a side third's hint: faint while hovered ("double tap to
// skip 10 s"), solid while a skip is shown with the taps added up.
templ seekZoneHint(dir string) {
	{{
		back := dir == "back"
		shown := fmt.Sprintf("$_seekHint === '%s' || ($_zone === '%s' && !$_idle && !$_seekHint)", dir, dir)
		text := fmt.Sprintf("($_seekHint === '%s' ? $_seekSum : 10) + ' ' + %s", dir, trJS(ctx, "s"))
	}}
	<div class={ "absolute inset-y-0 w-1/3 grid place-items-center pointer-events-none", templ.KV("left-0", back), templ.KV("right-0", !back) } aria-hidden="true" data-show={ shown }>
		<span
			class="badge badge-lg bg-base-content/60 text-base-100 border-0 gap-1 font-mono tabular-nums transition-opacity"
			data-class:opacity-60={ fmt.Sprintf("$_seekHint !== '%s'", dir) }
		>
			if back {
				@Icon("chevrons-left", "size-4")
			}
			<span data-text={ text }>10 { tr(ctx, "s") }</span>
			if !back {
				@Icon("chevrons-right", "size-4")
			}
		</span>
	</div>
}

// playKindSwitch shows what the player plays and switches it, keeping the
// position: Direct always, HLS with GStreamer.
templ playKindSwitch(browser ...bool) {
	{{ cloud := len(browser) > 0 && browser[0] }}
	<div role="group" aria-label={ tr(ctx, "Stream") } class="join shrink-0">
		<button
			type="button"
			class="btn btn-xs join-item font-bold"
			data-class="{ 'btn-primary': $playKind === 'direct' }"
			aria-label={ trf(ctx, "Play %s", tr(ctx, "Direct")) }
			data-on:click={ "if ($playKind !== 'direct') { $playKind = 'direct'\n" + playerStart(cloud) + "\n}" }
		>{ tr(ctx, "Direct") }</button>
		<button
			type="button"
			class="btn btn-xs join-item font-bold"
			data-class="{ 'btn-secondary': $playKind === 'hls' }"
			data-show="$gst"
			aria-label={ trf(ctx, "Play %s", "HLS") }
			data-on:click={ "if ($playKind !== 'hls') { $playKind = 'hls'\n" + playerStart(cloud) + "\n}" }
		>HLS</button>
	</div>
}

templ torrListToolbar(n int) {
	<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-base-200/40 p-4 rounded-box border border-base-content/10">
		<div class="flex items-center gap-3">
			<h2 id="torr-list-title" class="text-xl font-bold flex items-center gap-2">
				@Icon("film", "size-5 text-primary")
				{ tr(ctx, "Torrents") }
				@torrCount(n)
			</h2>
			<span class="badge badge-sm badge-soft badge-success gap-1.5 font-mono text-[11px]">
				<span class="status status-success animate-pulse"></span>
				{ tr(ctx, "Live Sync") }
			</span>
		</div>
		<label class="input input-sm w-full sm:w-64">
			@Icon("search", "size-3.5 opacity-50")
			<input type="search" data-bind:filter-query placeholder={ tr(ctx, "Search torrents…") } aria-label={ tr(ctx, "Search torrents") }/>
		</label>
	</div>
}
