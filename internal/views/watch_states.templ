package views

import "fmt"

func watchStateURL(kind string, id int) string {
	return fmt.Sprintf("/api/titles/state?type=%s&id=%d", kind, id)
}

// watchStateSlot is where a title page's watch-state buttons go; it asks
// for the title's state when the page loads.
templ watchStateSlot(kind string, id int) {
	<span id={ titleControlID(ctx, "watch-state") } class="contents" data-init={ fmt.Sprintf("@get('%s')", titleControlURL(ctx, watchStateURL(kind, id))) }></span>
}

// WatchStateButtons mark a title Want to watch or Watched; pressing the
// pressed one clears it. Each click patches the buttons in their new state.
templ WatchStateButtons(kind string, id int, state string) {
	<div id={ titleControlID(ctx, "watch-state") } class={ templ.KV("join", playerControls(ctx)==""), templ.KV("flex flex-wrap gap-2", playerControls(ctx)!="") } role="group" aria-label={ tr(ctx, "Watch state") }>
		@watchStateButton(kind, id, "want", state, "bookmark", tr(ctx, "Want to watch"))
		@watchStateButton(kind, id, "watched", state, "eye", tr(ctx, "Watched"))
	</div>
}

templ watchStateButton(kind string, id int, value, state, icon, label string) {
	<button
		type="button"
		data-state={ value }
		aria-pressed={ boolAttr(state == value) }
		class={ watchStateButtonClass(ctx), templ.KV("btn-primary", state == value), templ.KV("btn-ghost text-base-content border-base-content/30 hover:bg-base-content/10", state != value && playerControls(ctx) != ""), templ.KV("btn-ghost text-neutral-content border-neutral-content/30 hover:bg-neutral-content/10", state != value && playerControls(ctx) == "") }
		if state == value {
			data-on:click={ fmt.Sprintf("@delete('%s')", titleControlURL(ctx, watchStateURL(kind, id))) }
		} else {
			data-on:click={ fmt.Sprintf("@post('%s&state=%s')", titleControlURL(ctx, watchStateURL(kind, id)), value) }
		}
	>
		@Icon(icon, "size-5")
		{ label }
	</button>
}

templ WatchStateSaveFailed(kind string, id int, state string) {
	{{
		retry := fmt.Sprintf("@delete('%s')", titleControlURL(ctx, watchStateURL(kind, id)))
		if state != "" {
			retry = fmt.Sprintf("@post('%s&state=%s')", titleControlURL(ctx, watchStateURL(kind, id)), state)
		}
	}}
	@titleControlFailure(titleControlID(ctx, "watch-state"), retry)
}
