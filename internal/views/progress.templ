package views

import (
	"context"
	"encoding/json"
	"fmt"
	"path"
	"strconv"
	"strings"
	"time"

	"github.com/lieranderl/moviestracker-app/internal/store"
	"github.com/lieranderl/moviestracker-app/internal/tmdb"
)

// clockTime is d as a player shows it: 42:10, or 1:02:05 past an hour.
func clockTime(d time.Duration) string {
	s := int(d / time.Second)
	if s >= 3600 {
		return fmt.Sprintf("%d:%02d:%02d", s/3600, s/60%60, s%60)
	}
	return fmt.Sprintf("%d:%02d", s/60, s%60)
}

// progressSave reports where the player is, at most every 15 seconds while
// the video plays (on its timeupdate events: no timer asks the server).
// The web app relays the torrent from the user's TorrServer; the local app
// looks it up itself.
func progressSave(browser bool) string {
	torrent := ""
	if browser {
		torrent = ", torrent: $_progressTorrent"
	}
	return `$playerOpen && $_dur > 0 && @post('/api/progress', {payload: {hash: $activeHash, index: +$activeFileIndex, position: $_time, duration: $_dur` + torrent + `}})`
}

// progressResumeFetch asks where the user stopped whenever a file opens.
const progressResumeFetch = `$playerOpen && $activeHash && @get('/api/progress/resume?hash=' + $activeHash + '&index=' + $activeFileIndex, {filterSignals: {include: /^$/}})`

// TorrResume offers to jump to where the user stopped in a file; at 0 it
// offers nothing. It hides once the video passes that point or another
// file opens.
templ TorrResume(hash string, index int, at time.Duration) {
	<div id="torr-resume" class="absolute left-3 bottom-20 z-30">
		if at > 0 {
			{{ key := fmt.Sprintf("%s-%d", hash, index) }}
			<div
				role="status"
				class="alert alert-soft shadow-xl py-2 text-sm"
				data-signals:_resume={ "'" + key + "'" }
				data-show={ fmt.Sprintf("$_resume === '%s' && $activeHash === '%s' && +$activeFileIndex === %d && $_time < %d", key, hash, index, int(at/time.Second)) }
			>
				@Icon("history", "size-4")
				<span>{ trf(ctx, "Resume from %s", clockTime(at)) }</span>
				<button type="button" class="btn btn-sm btn-primary" data-on:click={ fmt.Sprintf("$_video.currentTime = %d; $_resume = ''", int(at/time.Second)) }>{ tr(ctx, "Resume") }</button>
				<button type="button" class="btn btn-sm btn-ghost" data-on:click="$_resume = ''">{ tr(ctx, "Start over") }</button>
			</div>
		}
	</div>
}

// progressPoster is a progress entry's poster: TorrServer keeps a URL, the
// web app may keep a TMDB path.
func progressPoster(p store.Progress) string {
	if strings.HasPrefix(p.Poster, "https://") || strings.HasPrefix(p.Poster, "http://") {
		return p.Poster
	}
	return tmdb.MediaItem{PosterPath: p.Poster}.PosterURL()
}

// progressPlay opens the TorrServer page's player on the entry's file.
func progressPlay(p store.Progress) templ.SafeURL {
	return templ.SafeURL(fmt.Sprintf("/torrserver?play=%s&file=%d", p.Hash, p.Index))
}

func progressPercent(p store.Progress) int {
	if p.Duration <= 0 {
		return 0
	}
	return int(p.Position * 100 / p.Duration)
}

// continueWatching is the home row of files the user has not finished.
templ continueWatching(watching []store.Progress) {
	<section id="continue-watching" class="relative space-y-4 scroll-mt-32" aria-labelledby="continue-watching-title">
		<header>
			<h2 id="continue-watching-title" class="text-xl sm:text-2xl font-bold tracking-tight flex items-center gap-2">
				@Icon("history", "size-5 text-secondary")
				{ tr(ctx, "Continue watching") }
			</h2>
		</header>
		@carousel() {
			for _, p := range watching {
				<li class="carousel-item">
					<a href={ progressPlay(p) } class="card w-40 sm:w-48 shrink-0 bg-base-200/60 hover:bg-base-200 border border-base-content/5 shadow-md group focus-visible:outline-2 focus-visible:outline-primary">
						<figure class="aspect-[2/3] relative bg-base-300">
							if poster := progressPoster(p); poster != "" {
								<img src={ poster } alt={ trf(ctx, "%s poster", p.Title) } class="size-full object-cover" loading="lazy" decoding="async" width="192" height="288"/>
							} else {
								@Icon("film", "size-10 opacity-40")
							}
							<span class="absolute inset-0 grid place-items-center opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity bg-base-300/40">
								@Icon("play", "size-10 text-primary-content bg-primary rounded-full p-2")
							</span>
						</figure>
						<div class="card-body p-3.5 gap-1.5">
							<h3 class="card-title text-sm line-clamp-1 group-hover:text-primary" title={ p.Title }>{ p.Title }</h3>
							if p.File != "" {
								<p class="text-xs text-base-content/60 line-clamp-1" title={ p.File }>{ path.Base(p.File) }</p>
							}
							<progress class="progress progress-primary h-1.5" value={ strconv.Itoa(progressPercent(p)) } max="100" aria-label={ tr(ctx, "Watched") }></progress>
							<p class="text-xs text-base-content/70 font-mono">{ trf(ctx, "%s left", clockTime(p.Duration-p.Position)) }</p>
						</div>
					</a>
				</li>
			}
		}
	</section>
}

// PlayRequest is a file a link asks the TorrServer page to play
// (/torrserver?play=<hash>&file=<id>), titled as the user last watched it.
type PlayRequest struct {
	Hash  string
	Index int
	Title string
}

type playRequestKey struct{}

// WithPlayRequest makes ctx's TorrServer page open the player on p's file.
func WithPlayRequest(ctx context.Context, p PlayRequest) context.Context {
	return context.WithValue(ctx, playRequestKey{}, p)
}

// autoplayScript starts the player on p's file: at once in the local app,
// in the web app once the user's TorrServer answers.
func autoplayScript(p PlayRequest, browser bool) string {
	title, _ := json.Marshal(p.Title)
	start := fmt.Sprintf("$activeHash = '%s'; $activeFileIndex = %d; $streamTitle = %s; $playKind = 'direct'; ", p.Hash, p.Index, title)
	if browser {
		return "if ($_autoplay && $tsSelected && $tsStatus.ok) { $_autoplay = false; " + start + webStartPlay() + " }"
	}
	return start + torrStartPlay
}

// torrAutoplay opens the player on the file the page's link asks for.
templ torrAutoplay(browser bool) {
	if p, ok := ctx.Value(playRequestKey{}).(PlayRequest); ok {
		if browser {
			<div id="torr-autoplay" class="hidden" data-signals:_autoplay="true" data-effect={ autoplayScript(p, true) }></div>
		} else {
			<div id="torr-autoplay" class="hidden" data-init={ autoplayScript(p, false) }></div>
		}
	}
}

// progressSlot is where a title page's Continue button goes; it asks where
// the user stopped when the page loads.
templ progressSlot(kind string, id int) {
	<span id="progress-button" class="contents" data-init={ fmt.Sprintf("@get('/api/progress/title?type=%s&id=%d')", kind, id) }></span>
}

// ProgressButton continues the title's file the user last left unfinished;
// with none it is an empty slot.
templ ProgressButton(p *store.Progress) {
	if p == nil {
		<span id="progress-button" class="contents"></span>
	} else {
		<a id="progress-button" href={ progressPlay(*p) } class="btn sm:btn-lg btn-secondary gap-2" title={ path.Base(p.File) }>
			@Icon("history", "size-5")
			{ trf(ctx, "Continue · %s of %s", clockTime(p.Position), clockTime(p.Duration)) }
		</a>
	}
}
