package views

// PrivacyPath is where the web app's privacy policy is.
const PrivacyPath = "/privacy"

// privacyUpdated is when the privacy policy last changed; change it with
// the policy.
const privacyUpdated = "2 November 2026"

// privacyEmail is the private address for questions about one's data and
// requests to delete it.
const privacyEmail = "moviestracker.scoured892@passinbox.com"

// googleConnectionsURL is where a Google account holder removes an app's
// access to their account.
const googleConnectionsURL = "https://myaccount.google.com/connections"

// privacyCookie is one of the web app's cookies, as the policy lists it.
type privacyCookie struct{ Name, Purpose, Lifetime string }

var privacyCookies = []privacyCookie{
	{Name: "mt_session", Purpose: "Keeps you signed in. Signed, so it cannot be forged.", Lifetime: "30 days"},
	{Name: "mt_signin", Purpose: "Protects one sign-in with Google from forgery.", Lifetime: "10 minutes"},
	{Name: "mt_lang", Purpose: "Remembers the interface language you picked.", Lifetime: "1 year"},
}

// WebPrivacy is the cloud web app's privacy policy, public to everyone.
templ WebPrivacy() {
	@layoutWithMeta(PageMeta{Title: tr(ctx, "Privacy policy"), Description: tr(ctx, "What Moviestracker keeps about you, why, and how to have it removed."), Path: PrivacyPath}) {
		<main class="grow flex flex-col">
			@authTopBar("/")
			<article class="grow w-full max-w-3xl mx-auto px-4 sm:px-8 py-10 space-y-8">
				<header class="space-y-2">
					<h1 class="text-4xl font-black tracking-tight">{ tr(ctx, "Privacy policy") }</h1>
					<p class="text-sm text-base-content/70">{ trf(ctx, "Last updated: %s", tr(ctx, privacyUpdated)) }</p>
				</header>
				<p>{ tr(ctx, "Moviestracker is a free, non-commercial and open-source catalog of movies and series. It keeps as little about you as it can, never sells it and shows no ads.") }</p>
				@privacySection(tr(ctx, "What we keep")) {
					<p>{ tr(ctx, "When you sign in with Google, Google tells us your Google account ID, email address, name and profile picture. Your name, email address and picture stay in your session cookie; we do not store them.") }</p>
					<p>{ tr(ctx, "Under your Google account ID we store, in Google Cloud Firestore:") }</p>
					<ul class="list-disc ps-6 space-y-1">
						<li>{ tr(ctx, "your favourites: each title, its poster and when you added it;") }</li>
						<li>{ tr(ctx, "the titles you marked Watched and Want to watch, and when;") }</li>
						<li>{ tr(ctx, "where you stopped watching each video, for Continue watching: the torrent's hash, the file's name, the title and the position;") }</li>
						<li>{ tr(ctx, "your release alerts: which movies you follow turned up in which release feed, when, and whether you have seen them;") }</li>
						<li>{ tr(ctx, "your lists: their names and titles. A list you share can be read by anyone with its link, until you stop sharing it;") }</li>
						<li>{ tr(ctx, "your ratings and private notes on titles, which only you see;") }</li>
						<li>{ tr(ctx, "your release filters: sorting, qualities, HDR and hiding recordings;") }</li>
						<li>{ tr(ctx, "the names and addresses of the TorrServers you add;") }</li>
						<li>{ tr(ctx, "the interface language you picked.") }</li>
					</ul>
				}
				@privacySection(tr(ctx, "What stays in your browser")) {
					<p>{ tr(ctx, "Your browser talks to your TorrServer directly; our server never connects to it. TorrServer usernames and passwords stay in your browser and are never sent to us.") }</p>
					<p>{ tr(ctx, "Your browser also keeps the TorrServer you last picked, your theme and your subtitle and audio languages in its local storage. When a page shows your TorrServer's torrents or settings, your browser sends them to us only to draw that page; we do not keep them.") }</p>
				}
				@privacySection(tr(ctx, "Cookies")) {
					<p>{ tr(ctx, "We use only the cookies the app needs to work. There are no advertising or analytics cookies and no trackers.") }</p>
					<div class="overflow-x-auto">
						<table class="table table-sm">
							<thead>
								<tr>
									<th>{ tr(ctx, "Cookie") }</th>
									<th>{ tr(ctx, "Purpose") }</th>
									<th>{ tr(ctx, "Lifetime") }</th>
								</tr>
							</thead>
							<tbody>
								for _, c := range privacyCookies {
									<tr>
										<td><code>{ c.Name }</code></td>
										<td>{ tr(ctx, c.Purpose) }</td>
										<td class="whitespace-nowrap">{ tr(ctx, c.Lifetime) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
				@privacySection(tr(ctx, "Services we rely on")) {
					<ul class="list-disc ps-6 space-y-1">
						<li>{ tr(ctx, "Google signs you in, and Google Cloud runs the app and stores your data. Its request logs record your IP address, browser and the pages you open, to keep the app secure and working.") }</li>
						<li>{ tr(ctx, "TMDB provides the catalog. Your browser loads posters and pictures from TMDB, which sees your IP address.") }</li>
						<li>{ tr(ctx, "Trailers play from YouTube in its privacy-enhanced mode, only when you start one.") }</li>
						<li>{ tr(ctx, "Our server searches JacRed for a title's releases; JacRed does not learn who you are.") }</li>
					</ul>
				}
				@privacySection(tr(ctx, "Your choices")) {
					<p>{ tr(ctx, "You can remove favourites, watch marks, lists, ratings, notes and TorrServers and change your release filters and language in the app at any time, and stop sharing a list. Signing out deletes your session cookie.") }</p>
					<p>
						{ tr(ctx, "On the Your data page you can download everything we keep for your account, or delete your account with all of it at once.") }
						<a href={ templ.SafeURL(AccountPath) } class="link link-primary">{ tr(ctx, "Your data") }</a>
					</p>
					<p>{ tr(ctx, "You can also remove Moviestracker's access to your Google account:") }</p>
					<p>
						<a href={ templ.SafeURL(googleConnectionsURL) } target="_blank" rel="noopener noreferrer" class="link link-primary">{ tr(ctx, "Google account connections") }</a>
					</p>
					<p>{ tr(ctx, "To ask anything about your data, or if you cannot delete your account yourself, write to us from the email address of your Google account. We answer deletion requests within 30 days.") }</p>
				}
				@privacySection(tr(ctx, "Contact")) {
					<p>
						{ tr(ctx, "Write to our privacy address:") }
						<a href={ templ.SafeURL("mailto:" + privacyEmail) } class="link link-primary break-all">{ privacyEmail }</a>
					</p>
					<p>{ tr(ctx, "Please do not post personal details in public places such as the project's issue tracker.") }</p>
				}
				@privacySection(tr(ctx, "Changes")) {
					<p>{ tr(ctx, "When this policy changes, this page shows the new version and its date.") }</p>
				}
			</article>
			@footer(false)
		</main>
	}
}

templ privacySection(title string) {
	<section class="space-y-3">
		<h2 class="text-2xl font-bold tracking-tight">{ title }</h2>
		{ children... }
	</section>
}
