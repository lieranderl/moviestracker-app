package views

import (
	"context"
	"fmt"
	"slices"
	"github.com/lieranderl/moviestracker-app/internal/auth"
	"github.com/lieranderl/moviestracker-app/internal/i18n"
	"github.com/lieranderl/moviestracker-app/internal/tmdb"
	"strings"
)

func tvFacts(ctx context.Context, t *tmdb.TVDetails) []string {
	facts := []string{tr(ctx, "TV Series")}
	if y := t.YearRange(); y != "" {
		facts = append(facts, y)
	}
	if t.NumberOfSeasons > 0 {
		facts = append(facts, trn(ctx, t.NumberOfSeasons, "%d season", "%d seasons"))
	}
	if next := t.NextEpisode; next.Number > 0 {
		if next.AirDate.IsZero() {
			facts = append(facts, trf(ctx, "Next episode: S%d E%d", next.Season, next.Number))
		} else {
			facts = append(facts, trf(ctx, "Next episode: S%d E%d, %s", next.Season, next.Number, i18n.Date(ctx, next.AirDate)))
		}
	}
	return facts
}

func tvAbout(ctx context.Context, t *tmdb.TVDetails) []factItem {
	episodes := ""
	if t.NumberOfEpisodes > 0 {
		episodes = fmt.Sprint(t.NumberOfEpisodes)
	}
	return []factItem{
		{Label: "Created by", People: t.Creators},
		{Label: "Networks", Value: strings.Join(t.Networks, ", ")},
		{Label: "Genres", Value: genreNames(t.Genres)},
		{Label: "First aired", Value: t.ReleaseDate},
		{Label: "Last aired", Value: t.LastAirDate},
		{Label: "Status", Value: tr(ctx, t.Status)},
		{Label: "Episodes", Value: episodes},
		{Label: "Episode runtime", Value: runtime(ctx, t.EpisodeRuntime)},
		{Label: "Original title", Value: originalTitle(t.OriginalTitle, t.Title)},
	}
}

// SeasonURL is the SSE endpoint that patches one season's episodes.
func SeasonURL(tvID, season int) string { return fmt.Sprintf("/api/tv/%d/season/%d", tvID, season) }

// seasonClick switches seasons in place; the links still work without JS.
func seasonClick(tvID int) string {
	return fmt.Sprintf(`const a = evt.target.closest('[data-season]')
if (a) { evt.preventDefault(); $season = +a.dataset.season; @get('/api/tv/%d/season/' + a.dataset.season) }`, tvID)
}

templ TVPage(user *auth.User, t *tmdb.TVDetails, season *tmdb.Season, selected int) {
	@layoutWithScripts(PageTitle(t.MediaItem), titleScripts(ctx)...) {
		@Navbar(user)
		<main class="grow pb-16" data-signals={ mediaPageSignals(ctx) } data-on:click={ videoClick(ctx) }>
			@detailHero(t.MediaItem, tvFacts(ctx, t), t.ContentRating, genreNames(t.Genres)) {
				@trailerButton(t.TrailerKey, trf(ctx, "%s trailer", t.Title))
				@heroLink("#seasons", "list-video", tr(ctx, "Episodes"))
				@progressSlot("tv", t.ID)
				@watchStateSlot("tv", t.ID)
				@listPickerSlot("tv", t.ID)
				if siteOf(ctx).Cloud {
					@favoriteSlot("tv", t.ID)
				}
				@heroLink("#sources", "magnet", tr(ctx, "Find sources"))
			}
			@reviewSlot("tv", t.ID)
			@aboutSection(t.MediaItem, t.Tagline, tvAbout(ctx, t), officialLinks("title", t.Links, t.Homepage))
			@seasonsSection(t, season, selected)
			@sourcesSection("tv", t.MediaItem, t.SeasonsSoFar(), selected, tmdb.Releases{})
			@castRail(tr(ctx, "Series cast"), t.Cast)
			@videoRail(t.Videos)
			@mediaRail("recommendations", tr(ctx, "Recommended"), t.Recommendations)
			@mediaRail("similar", tr(ctx, "More like this"), t.Similar)
			@trailerModal()
			@appToast()
		</main>
		@siteFooter()
	}
}

templ seasonsSection(t *tmdb.TVDetails, season *tmdb.Season, selected int) {
	if len(t.Seasons) > 0 {
		<section
			id="seasons"
			class="max-w-7xl mx-auto px-4 sm:px-8 py-6 space-y-5 scroll-mt-20"
			data-signals={ fmt.Sprintf("{ season: %d, seasonLoading: false }", selected) }
		>
			@sectionHeading(tr(ctx, "Seasons & episodes"), "") {
				@NextUnwatched(t, episodeMarksOf(ctx))
			}
			<nav
				class="tabs tabs-box w-full sm:w-fit max-w-full flex-nowrap overflow-x-auto"
				aria-label={ tr(ctx, "Seasons") }
				data-on:click={ seasonClick(t.ID) }
				data-indicator:season-loading
			>
				for _, s := range t.Seasons {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/tv/%d?season=%d#seasons", t.ID, s.Number)) }
						role="tab"
						data-season={ fmt.Sprint(s.Number) }
						class={ "tab shrink-0 whitespace-nowrap", templ.KV("tab-active", s.Number == selected) }
						data-class={ fmt.Sprintf("{ 'tab-active': $season === %d }", s.Number) }
					>
						{ seasonLabel(ctx, s) }
					</a>
				}
			</nav>
			<div class="transition-opacity" data-class="{ 'opacity-50': $seasonLoading }">
				if season != nil {
					@SeasonEpisodes(season, episodeMarksOf(ctx))
				} else {
					@SeasonError()
				}
			</div>
		</section>
	}
}

func seasonLabel(ctx context.Context, s tmdb.SeasonSummary) string {
	if s.Number == 0 {
		return tr(ctx, "Specials")
	}
	return trf(ctx, "Season %d", s.Number)
}

// seasonSourcesLabel is a season as its sources are picked: a season still
// airing says how much of it is out, since no release can hold the rest.
func seasonSourcesLabel(ctx context.Context, s tmdb.SeasonSummary) string {
	if s.Aired == 0 {
		return seasonLabel(ctx, s)
	}
	return seasonLabel(ctx, s) + " · " + trf(ctx, "%d of %d aired", s.Aired, s.EpisodeCount)
}

// NextUnwatched names the first aired episode the user has not watched.
templ NextUnwatched(t *tmdb.TVDetails, m EpisodeMarks) {
	<div id="next-unwatched">
		if m.Track {
			if season, episode, ok, any := nextUnwatched(t, m); ok {
				<a href={ templ.SafeURL(fmt.Sprintf("/tv/%d?season=%d#seasons", t.ID, season)) } class="btn btn-sm btn-primary btn-outline gap-1.5">
					@Icon("skip-forward", "size-4")
					{ trf(ctx, "Next: %s", fmt.Sprintf("S%02dE%02d", season, episode)) }
				</a>
			} else if any {
				<span class="badge badge-success badge-soft gap-1.5">
					@Icon("check-check", "size-3.5")
					{ tr(ctx, "All aired episodes watched") }
				</span>
			}
		}
	</div>
}

// SeasonEpisodes is patched by the season SSE endpoint; with m.Track the
// user marks its aired episodes watched one by one or all at once.
templ SeasonEpisodes(s *tmdb.Season, m EpisodeMarks) {
	<div id="season-episodes" class="space-y-4">
		if m.Track && slices.ContainsFunc(s.Episodes, EpisodeAired) {
			<div class="flex flex-wrap gap-2" role="group" aria-label={ tr(ctx, "Mark the season") }>
				<button type="button" class="btn btn-sm btn-ghost gap-1.5" data-on:click={ fmt.Sprintf("@post('%s')", SeasonMarkURL(s.ShowID, s.Number, true)) }>
					@Icon("check-check", "size-4")
					{ tr(ctx, "Mark season watched") }
				</button>
				<button type="button" class="btn btn-sm btn-ghost gap-1.5" data-on:click={ fmt.Sprintf("@post('%s')", SeasonMarkURL(s.ShowID, s.Number, false)) }>
					@Icon("rotate-ccw", "size-4")
					{ tr(ctx, "Mark season unwatched") }
				</button>
			</div>
		}
		if s.Overview != "" {
			<p class="text-sm text-base-content/70 max-w-3xl leading-relaxed">{ s.Overview }</p>
		}
		if len(s.Episodes) == 0 {
			<p class="text-sm text-base-content/70">{ tr(ctx, "No episodes announced yet.") }</p>
		}
		<ol class="grid grid-cols-1 lg:grid-cols-2 gap-4">
			for _, e := range s.Episodes {
				<li class="card card-side bg-base-200/60 border border-base-content/5 overflow-hidden">
					<figure class="w-36 sm:w-56 shrink-0 bg-base-300 aspect-video self-start">
						if e.StillURL() != "" {
							<img src={ e.StillURL() } alt="" class="size-full object-cover" loading="lazy" decoding="async" width="224" height="126"/>
						} else {
							@Icon("tv", "size-8 opacity-30")
						}
					</figure>
					<div class="card-body p-3 sm:p-4 gap-1 min-w-0">
						<p class="text-xs font-mono text-base-content/70 flex flex-wrap gap-x-2">
							<span class="font-semibold text-primary">{ e.Code() }</span>
							if r := runtime(ctx, e.Runtime); r != "" {
								<span>{ r }</span>
							}
							if e.AirDate != "" {
								<span>{ e.AirDate }</span>
							}
						</p>
						<div class="flex items-start justify-between gap-2">
							<h3 class="font-semibold leading-snug line-clamp-2">{ e.Name }</h3>
							if m.Track && EpisodeAired(e) {
								{{ on := m.watched(s.Number, e.Number) }}
								<button
									type="button"
									id={ fmt.Sprintf("episode-%d-%d", s.Number, e.Number) }
									aria-pressed={ boolAttr(on) }
									aria-label={ trf(ctx, "Watched %s", e.Code()) }
									title={ tr(ctx, "Watched") }
									class={ "btn btn-xs btn-circle shrink-0", templ.KV("btn-primary", on), templ.KV("btn-ghost", !on) }
									data-on:click={ fmt.Sprintf("@post('%s')", EpisodeURL(s.ShowID, s.Number, e.Number, !on)) }
								>
									@Icon("eye", "size-3.5")
								</button>
							}
						</div>
						if e.Overview != "" {
							<p class="text-xs sm:text-sm text-base-content/70 line-clamp-3">{ e.Overview }</p>
						}
					</div>
				</li>
			}
		</ol>
	</div>
}

templ SeasonError() {
	<div id="season-episodes" role="alert" class="alert alert-warning alert-soft">
		@Icon("triangle-alert", "size-5")
		<span>{ tr(ctx, "This season could not be loaded from TMDB. Please try again.") }</span>
	</div>
}
