package views

import (
	"fmt"
	"cmp"
	"slices"

	"github.com/lieranderl/moviestracker-app/internal/torrserver"
)

// maxRecentTorrents is how many of the last added torrents home shows.
const maxRecentTorrents = 10

// RecentTorrentsSlot is home's row of the torrents last added to TorrServer,
// filled into #recent-torrents-row (RecentTorrents) by load: the site
// adapter's way to list them. The app asks its server, which reaches
// TorrServer; the web app's browser lists the visitor's and posts them.
templ RecentTorrentsSlot(load templ.Attributer) {
	<section id="recent-torrents" class="hidden has-[.carousel-item]:block" { load... }>
		<div id="recent-torrents-row"></div>
	</section>
}

// RecentTorrents is the row of the torrents added last, newest first;
// nothing when the TorrServer has none. Each opens its title's page when
// known (page is the app's own match of a hash to a title, nil if none).
templ RecentTorrents(torrents []torrserver.Torrent, page func(hash string) string) {
	<div id="recent-torrents-row">
		if recent := recentTorrents(torrents); len(recent) > 0 {
			<div class="space-y-4">
				@rowHeader() {
					@rowTitle("", "server", true, tr(ctx, "Recently added to TorrServer"))
					@rowLink("/torrserver", tr(ctx, "Open TorrServer"), "")
				}
				@carousel() {
					for _, t := range recent {
						<li class="carousel-item">
							<a href={ templ.SafeURL(recentTorrentHref(t, page)) } class="card w-40 sm:w-48 shrink-0 bg-base-200/60 hover:bg-base-200 border border-base-content/5 shadow-md transition group focus-visible:outline-2 focus-visible:outline-primary">
								<figure class="aspect-[2/3] bg-base-300">
									if t.Poster != "" {
										<img src={ t.Poster } alt="" class="size-full object-cover" loading="lazy" decoding="async"/>
									} else {
										@Icon("film", "size-10 opacity-40")
									}
								</figure>
								<div class="card-body p-3 gap-1.5">
									<h3 class="text-sm font-semibold line-clamp-2 leading-tight group-hover:text-primary" title={ t.DisplayName() }>{ t.DisplayName() }</h3>
									<span class={ "badge badge-xs", t.StatusBadgeClass() }>{ tr(ctx, t.StatusLabel()) }</span>
								</div>
							</a>
						</li>
					}
				}
			</div>
		}
	</div>
}

// recentTorrentHref is the page of the torrent's title: from its data,
// else from page, else the TorrServer page.
func recentTorrentHref(t torrserver.Torrent, page func(string) string) string {
	if kind, id := t.TMDB(); kind != "" {
		return fmt.Sprintf("/%s/%d", kind, id)
	}
	if page != nil {
		if href := page(t.Hash); href != "" {
			return href
		}
	}
	return "/torrserver"
}

// recentTorrents are the torrents added last, newest first.
func recentTorrents(torrents []torrserver.Torrent) []torrserver.Torrent {
	out := slices.Clone(torrents)
	slices.SortStableFunc(out, func(a, b torrserver.Torrent) int { return cmp.Compare(b.Timestamp, a.Timestamp) })
	return out[:min(len(out), maxRecentTorrents)]
}
