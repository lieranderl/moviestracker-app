package views

import (
	"encoding/json"
	"fmt"
	"path"
	"strings"

	"github.com/lieranderl/moviestracker-app/internal/torrserver"
)

func webStartPlay() string {
	return `$audioTrack = -1; $subTrack = -1; $_audioMenu = false; $_subMenu = false; $streamCleanUrl = ''; $streamHlsUrl = ''; $_unplayable = ''; $_tsPlayerProblem = ''; $_tsProbeProblem = ''; $playNonce++; $playerOpen = true`
}

func webNext() string {
	return `if ($_queueHash !== $activeHash || $audioTrack < 0) return; const at = $_queue.findIndex(f => f.index === +$activeFileIndex); if (at >= 0 && at + 1 < $_queue.length) { const f = $_queue[at + 1]; $activeFileIndex = f.index; $streamTitle = f.title; ` + webStartPlay() + ` }`
}

func webPlayerSignals() string {
	return strings.TrimSuffix(torrPageSignals(false, true, ""), "}") + `, _tsPlayerProblem: '', _tsProbeProblem: '', _tsPlayerOrigin: '', _tsPlayingFile: '' }`
}

func playerStart(browser bool) string {
	if browser {
		return webStartPlay()
	}
	return torrStartPlay
}

func playerNext(browser bool) string {
	if browser {
		return webNext()
	}
	return torrPlayNext
}

func webPlaylistPick() string {
	return `const b = evt.target.closest('[data-at]'); if (b && $_queueHash === $activeHash) { const f = $_queue[+b.dataset.at]; if (f) { $_listMenu = false; $activeFileIndex = f.index; $streamTitle = f.title; ` + webStartPlay() + ` } }`
}

func confirmRemove(browser bool) string {
	if browser {
		return `tsTorrentAction($_list, $tsSelected, 'rem', $confirmHash); $confirmOpen = false`
	}
	return `@post('/api/torrserver/action?op=rem&hash=' + encodeURIComponent($confirmHash), {filterSignals: {include: /^$/}}); $confirmOpen = false`
}

templ webPlayer() {
	@torrPlayerModalFor(true)
	@torrConfirmModalFor(true)
	@torrProbeModalFor(true)
	@torrFileMenu()
	@torrToast()
}

templ webPlayerTransport() {
	<div
		id="ts-player-session"
		data-ref:_session
		data-effect="$playerOpen ? tsPlayerLoad(el, $tsSelected, $activeHash, +$activeFileIndex, $playKind, $playNonce) : tsPlayerCancel(el)"
		data-on:ts-player={ webPlayerLoaded() }
		data-on:ts-player-stats="$_tsPlayerProblem = evt.detail.problem || evt.detail.heartbeatProblem; if (evt.detail.torrent) { @post('/api/ts/player-stats', {payload: evt.detail}) }"
		data-on-interval__duration.2s="$playerOpen && tsPlayerTick(el)"
		data-on:pagehide__window="tsPlayerCancel(el)"
	></div>
	<div data-effect="if ($playerOpen && $_tsPlayerOrigin && $_tsPlayerOrigin !== $tsSelected) { $playerOpen = false }; $_tsPlayerOrigin = $tsSelected"></div>
	<div data-effect={ webPlayback() }></div>
	<div id="ts-player-controls"></div>
}

templ webPlayerProblems() {
	<div class="alert alert-warning alert-soft mt-3" role="alert" data-show="$_tsPlayerProblem || $_tsProbeProblem">
		<span>{ tr(ctx,"TorrServer could not load playback information. Check the connection or login, then retry.") }</span>
		<button class="btn btn-sm" type="button" data-on:click={ webStartPlay() }>{ tr(ctx,"Retry") }</button>
	</div>
	<span class="loading loading-spinner loading-sm mt-3" data-show="$audioTrack < 0 && !$_tsPlayerProblem"></span>
}

func webPlayerLoaded() string {
	return `const d = evt.detail; if (d.nonce !== $playNonce || d.hash !== $activeHash || d.index !== +$activeFileIndex || !$playerOpen) return
$_tsPlayerProblem = d.problem; $_tsProbeProblem = d.probeProblem
if (!d.torrent || d.problem) return
const audio = d.probe?.Tracks?.filter(t => t.Type === 'audio') || []
$audioTrack = audio.find(t => t.Language?.toLowerCase() === $audioLang.toLowerCase())?.Index ?? audio[0]?.Index ?? 0
@post('/api/ts/player', {payload:d})`
}

func webPlayback() string {
	return `$playerOpen && $audioTrack >= 0
 ? tsPlayerLease($_session, $tsSelected, $activeHash, +$activeFileIndex, $playKind, $audioTrack).then(links => { if (links) { $streamCleanUrl = links.direct; $streamHlsUrl = links.hls; playHlsVideo($streamUrl = links.stream, $_tsPlayingFile === links.file, true); $_tsPlayingFile = links.file } })
 : ($playerOpen ? $_video?.pause() : (window.stopHlsVideo?.(), $_tsPlayingFile = ''), tsPlayerRelease($_session))`
}

// WebPlayerControls guards late relay responses against a newer file or server.
templ WebPlayerControls(hash string, index, nonce int, files []torrserver.FileStat) {
	{{
		queue := make([]QueuedFile, len(files))
		for i, f := range files {
			queue[i] = QueuedFile{Index: f.ID, Title: path.Base(f.Path)}
		}
		data, _ := json.Marshal(queue)
	}}
	<div
		id="ts-player-controls"
		class="contents"
		data-hash={ hash }
		data-index={ fmt.Sprint(index) }
		data-nonce={ fmt.Sprint(nonce) }
		data-queue={ string(data) }
		data-show={ webRelayCurrent }
		data-init={ "if (" + webRelayCurrent + ") { $_queue = JSON.parse(el.dataset.queue); $_queueHash = el.dataset.hash }" }
	></div>
}

// webRelayCurrent holds when a relayed element (its data-hash, data-index and
// data-nonce) belongs to the file the player shows now.
const webRelayCurrent = `$activeHash === el.dataset.hash && +$activeFileIndex === +el.dataset.index && $playNonce === +el.dataset.nonce`

// WebPlayerSlot wraps a relayed player control, such as the audio picker, so
// a late response for an earlier file or server stays hidden.
templ WebPlayerSlot(id, hash string, index, nonce int, content templ.Component) {
	<div id={ id } class="contents" data-hash={ hash } data-index={ fmt.Sprint(index) } data-nonce={ fmt.Sprint(nonce) } data-show={ webRelayCurrent }>
		@content
	</div>
}

// playerSlot is where WebPlayerSlot patches a control; the local app's player
// patches the control itself.
templ playerSlot(id string, browser bool) {
	if browser {
		<div id={ id } class="contents">
			{ children... }
		</div>
	} else {
		{ children... }
	}
}

func probeOpenAction(browser bool) string {
	if browser {
		return ""
	}
	return `@get('/api/torrserver/probe?hash=' + encodeURIComponent($probeHash) + '&index=' + $probeIndex)`
}

templ webProbeTransport() {
	<div
		data-effect="$probeOpen ? tsProbe(el, $tsSelected, $probeHash, +$probeIndex) : tsProbeCancel(el)"
		data-on:ts-probe-loading="$probeLoading = true"
		data-on:ts-probe="const d = evt.detail; if (!$probeOpen || d.url !== $tsSelected || d.hash !== $probeHash || d.index !== +$probeIndex) return; $probeLoading = false; @post('/api/ts/probe', {payload:d})"
	></div>
}
