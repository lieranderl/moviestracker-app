package views

import (
	"context"
	"slices"
	"time"
	"github.com/lieranderl/moviestracker-app/internal/i18n"
	"strconv"
	"github.com/lieranderl/moviestracker-app/internal/auth"
	"github.com/lieranderl/moviestracker-app/internal/jacred"
	"github.com/lieranderl/moviestracker-app/internal/tmdb"
	"github.com/lieranderl/moviestracker-app/internal/torrserver"
	"fmt"
	"strings"
)

// mediaPageSignals is the client state shared by the movie and TV pages.
const mediaPageSignals = `{ videoOpen: false, videoKey: '', videoTitle: '', torrMagnet: '', sending: false, trackers: [], voices: [], hideRecordings: false, toast: '', toastError: false }`

// videoClick opens the trailer dialog for any element carrying data-video.
// Keys and names travel in data-* attributes, never inside the expression.
func videoClick(ctx context.Context) string {
	return `const b = evt.target.closest('[data-video]')
if (b) { $videoKey = b.dataset.video; $videoTitle = b.dataset.title || ` + trJS(ctx, "Trailer") + `; $videoOpen = true }`
}

// mediaHref links a movie or series card to its detail page.
func mediaHref(item tmdb.MediaItem) templ.SafeURL {
	if item.MediaType == "tv" {
		return templ.SafeURL(fmt.Sprintf("/tv/%d", item.ID))
	}
	return templ.SafeURL(fmt.Sprintf("/movie/%d", item.ID))
}

func personHref(id int) templ.SafeURL { return templ.SafeURL(fmt.Sprintf("/person/%d", id)) }

// PageTitle renders "Title (2010)" for the document title and TorrServer entries.
func PageTitle(item tmdb.MediaItem) string {
	if y := item.ReleaseYear(); y != "" {
		return item.Title + " (" + y + ")"
	}
	return item.Title
}

func genreNames(genres []tmdb.Genre) string {
	names := make([]string, 0, len(genres))
	for _, g := range genres {
		names = append(names, g.Name)
	}
	return strings.Join(names, ", ")
}

// MediaError is the page shown when a title cannot be loaded.
templ MediaError(user *auth.User, heading, message string) {
	@Layout(heading) {
		@Navbar(user)
		<main class="grow grid place-items-center px-4 py-24">
			<div class="text-center space-y-4 max-w-md">
				@Icon("film", "size-12 mx-auto text-base-content/30")
				<h1 class="text-2xl font-bold">{ heading }</h1>
				<p class="text-base-content/70">{ message }</p>
				<a href={ templ.SafeURL(homeHref(ctx)) } class="btn btn-primary">{ tr(ctx, "Back to trending") }</a>
			</div>
		</main>
		@siteFooter()
	}
}

// detailHero is the full-bleed cinematic header of a title page. Action
// buttons are passed as children.
templ detailHero(item tmdb.MediaItem, facts []string, rating string, genres string) {
	<!-- Fills the viewport below the sticky navbar (4rem); details follow on scroll -->
	<section class="relative isolate flex items-end min-h-[calc(100svh-4rem)] overflow-hidden bg-black">
		if item.BackdropURL() != "" {
			<img src={ item.BackdropURL() } alt="" class="absolute inset-0 -z-10 size-full object-cover object-top" fetchpriority="high" decoding="async"/>
		} else if item.PosterURL() != "" {
			<img src={ item.PosterURL() } alt="" class="absolute inset-0 -z-10 size-full object-cover blur-3xl scale-110 opacity-60" decoding="async"/>
		}
		<div class="absolute inset-0 -z-10 bg-linear-to-t from-black via-black/55 via-40% to-black/0"></div>
		<div class="absolute inset-0 -z-10 bg-linear-to-r from-black/80 via-black/25 via-55% to-transparent"></div>
		<div class="w-full max-w-7xl mx-auto px-4 sm:px-8 pt-40 pb-20 lg:pb-24 text-white">
			<div class="max-w-2xl space-y-5">
				<h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-balance drop-shadow-lg">
					if item.LogoURL() != "" {
						<img src={ item.LogoURL() } alt={ item.Title } class="max-h-24 sm:max-h-32 lg:max-h-40 max-w-[18rem] sm:max-w-md w-auto object-contain object-left drop-shadow-xl"/>
					} else {
						{ item.Title }
					}
				</h1>
				<div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm font-medium text-white/85">
					for i, f := range facts {
						if i > 0 {
							<span aria-hidden="true" class="text-white/40">·</span>
						}
						<span>{ f }</span>
					}
					if rating != "" {
						<span class="badge badge-sm badge-outline border-white/50 text-white font-semibold">{ rating }</span>
					}
					if genres != "" {
						<span aria-hidden="true" class="text-white/40">·</span>
						<span>{ genres }</span>
					}
				</div>
				<div class="flex flex-wrap items-center gap-2">
					@tmdbRatingBadge(item)
					if item.ImdbID != "" {
						@HeroIMDbRatingBadge("detail-imdb-rating", item.ImdbID)
					}
				</div>
				if item.Overview != "" {
					<p class="text-sm sm:text-base text-white/85 leading-relaxed max-w-xl">{ item.Overview }</p>
				}
				<div class="flex flex-wrap gap-3 pt-1">
					{ children... }
				</div>
			</div>
		</div>
		<a href="#about" class="absolute bottom-5 left-1/2 -translate-x-1/2 btn btn-ghost btn-circle text-white/70 hover:text-white hover:bg-white/10 animate-bounce" aria-label={ tr(ctx, "Scroll to details") }>
			@Icon("chevron-down", "size-6")
		</a>
	</section>
}

// trailerButton is picked up by the page-level videoClick delegate.
templ trailerButton(key, title string) {
	if key != "" {
		<button type="button" class="btn sm:btn-lg bg-white text-black border-white hover:bg-white/85 gap-2" data-video={ key } data-title={ title }>
			@Icon("play", "size-5 fill-current")
			{ tr(ctx, "Play trailer") }
		</button>
	}
}

templ heroLink(href templ.SafeURL, icon, label string) {
	<a href={ href } class="btn sm:btn-lg btn-ghost text-white border-white/30 hover:bg-white/10 gap-2">
		@Icon(icon, "size-5")
		{ label }
	</a>
}

templ sectionHeading(title, subtitle string) {
	<header class="flex flex-wrap items-end justify-between gap-x-4 gap-y-3">
		<div>
			<h2 class="text-xl sm:text-2xl font-bold tracking-tight">{ title }</h2>
			if subtitle != "" {
				<p class="text-sm text-base-content/70">{ subtitle }</p>
			}
		</div>
		{ children... }
	</header>
}

// carousel scrolls its items sideways: swiped on touch screens, with back
// and forward buttons where there is a mouse, which has no sideways scroll.
templ carousel() {
	<div class="relative group/carousel">
		<ul class="carousel carousel-start w-[calc(100%+2rem)] gap-4 scroll-smooth scroll-px-4 -mx-4 px-4 -mt-3 pt-3 -mb-5 pb-8">
			{ children... }
		</ul>
		@carouselButton(false)
		@carouselButton(true)
	</div>
}

// carouselButton scrolls its carousel most of a view back or forward.
templ carouselButton(forward bool) {
	{{
		label, icon, side, sign := tr(ctx, "Scroll back"), "chevron-left", "-left-3", "-"
		if forward {
			label, icon, side, sign = tr(ctx, "Scroll forward"), "chevron-right", "-right-3", ""
		}
	}}
	<button
		type="button"
		class={ "hidden pointer-fine:inline-flex btn btn-circle absolute top-1/2 -translate-y-1/2 z-10 bg-base-100/90 border-base-content/10 shadow-lg opacity-0 transition-opacity group-hover/carousel:opacity-100 focus-visible:opacity-100", side }
		aria-label={ label }
		title={ label }
		data-on:click={ "const ul = el.parentElement.querySelector('.carousel'); ul.scrollBy({left: " + sign + "0.8 * ul.clientWidth})" }
	>
		@Icon(icon, "size-5")
	</button>
}

// rail is a horizontally scrolling carousel section; items are the children.
templ rail(id, title, subtitle string) {
	<section id={ id } class="max-w-7xl mx-auto px-4 sm:px-8 py-6 space-y-4" aria-label={ title }>
		@sectionHeading(title, subtitle)
		@carousel() {
			{ children... }
		}
	</section>
}

templ mediaRail(id, title string, items []tmdb.MediaItem) {
	if len(items) > 0 {
		@rail(id, title, "") {
			for _, item := range items {
				<li class="carousel-item">
					@MediaCard(item)
				</li>
			}
		}
	}
}

templ castRail(title string, cast []tmdb.CastMember) {
	if len(cast) > 0 {
		@rail("cast", title, "") {
			for _, c := range cast {
				<li class="carousel-item">
					@personTile(c.ID, c.Name, c.Character, c.ProfileURL())
				</li>
			}
		}
	}
}

templ personTile(id int, name, role, imageURL string) {
	<a href={ personHref(id) } class="group flex flex-col items-center gap-2 w-28 sm:w-32 text-center">
		if imageURL != "" {
			<div class="avatar">
				<div class="w-24 sm:w-28 rounded-full bg-base-300 ring-1 ring-base-content/10 group-hover:ring-primary transition">
					<img src={ imageURL } alt="" loading="lazy" decoding="async" width="112" height="112"/>
				</div>
			</div>
		} else {
			<div class="avatar avatar-placeholder">
				<div class="w-24 sm:w-28 rounded-full bg-base-300 text-base-content/70 ring-1 ring-base-content/10 group-hover:ring-primary transition">
					<span class="text-2xl font-semibold">{ initials(name) }</span>
				</div>
			</div>
		}
		<span class="text-sm font-semibold leading-tight line-clamp-2 group-hover:text-primary transition-colors">{ name }</span>
		if role != "" {
			<span class="text-xs text-base-content/70 leading-tight line-clamp-2">{ role }</span>
		}
	</a>
}

func initials(name string) string {
	var out []rune
	for _, word := range strings.Fields(name) {
		out = append(out, []rune(word)[0])
		if len(out) == 2 {
			break
		}
	}
	return strings.ToUpper(string(out))
}

templ videoRail(videos []tmdb.Video) {
	if len(videos) > 0 {
		@rail("videos", tr(ctx, "Trailers & videos"), "") {
			for _, v := range videos {
				<li class="carousel-item">
					<button type="button" class="group w-72 sm:w-80 text-left space-y-2" data-video={ v.Key } data-title={ v.Name }>
						<span class="relative block aspect-video rounded-box overflow-hidden bg-base-300">
							<img src={ v.ThumbnailURL() } alt="" class="size-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async" width="320" height="180"/>
							<span class="absolute inset-0 grid place-items-center bg-black/20 group-hover:bg-black/35 transition">
								<span class="size-12 rounded-full bg-white/90 text-black grid place-items-center shadow-xl">
									@Icon("play", "size-5 fill-current ml-0.5")
								</span>
							</span>
						</span>
						<span class="block text-sm font-semibold line-clamp-1 group-hover:text-primary">{ v.Name }</span>
						<span class="block text-xs text-base-content/70">{ tr(ctx, v.Type) }</span>
					</button>
				</li>
			}
		}
	}
}

// trailerModal plays the selected YouTube video; the iframe only gets a src
// while the dialog is open, so closing it stops playback.
templ trailerModal() {
	@modalDialog("trailer-modal", "videoOpen", "", "$videoKey = ''", "max-w-5xl w-full p-0 bg-black overflow-hidden", nil) {
		<h3 id="trailer-modal-title" class="sr-only" data-text="$videoTitle">{ tr(ctx, "Trailer") }</h3>
		<form method="dialog" class="absolute top-2 right-2 z-10">
			<button class="btn btn-sm btn-circle bg-black/60 border-white/20 text-white hover:bg-black" aria-label={ tr(ctx, "Close trailer") }>
				@Icon("x", "size-4")
			</button>
		</form>
		<div class="aspect-video">
			<iframe
				title={ tr(ctx, "Trailer") }
				class="size-full border-0"
				data-attr:src="$videoOpen && $videoKey ? 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent($videoKey) + '?autoplay=1&rel=0&playsinline=1' : null"
				allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
				allowfullscreen
			></iframe>
		</div>
	}
}

type factItem struct {
	Label  string
	Value  string
	People []tmdb.CrewMember
}

// aboutSection holds the poster, tagline, credits and official links; the
// overview itself lives in the hero so it is shown once.
templ aboutSection(item tmdb.MediaItem, tagline string, facts []factItem, links []officialLink) {
	<section id="about" class="max-w-7xl mx-auto px-4 sm:px-8 py-12 grid grid-cols-1 md:grid-cols-[12rem_1fr] lg:grid-cols-[15rem_1fr] gap-8 lg:gap-12">
		<figure class="hidden md:block">
			if item.PosterURL() != "" {
				<img src={ item.PosterURL() } alt={ trf(ctx, "%s poster", item.Title) } class="w-full aspect-[2/3] object-cover rounded-box shadow-2xl ring-1 ring-base-content/10" loading="lazy" decoding="async" width="240" height="360"/>
			} else {
				<div class="w-full aspect-[2/3] rounded-box bg-base-300 grid place-items-center">
					@Icon("film", "size-10 opacity-40")
				</div>
			}
		</figure>
		<div class="space-y-6 min-w-0">
			<h2 class="sr-only">{ tr(ctx, "About") }</h2>
			if tagline != "" {
				<p class="text-lg sm:text-xl italic text-base-content/70">{ tagline }</p>
			}
			<dl class="grid grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-5 text-sm max-w-4xl">
				for _, f := range facts {
					if f.Value != "" || len(f.People) > 0 {
						<div class="space-y-1 min-w-0">
							<dt class="text-xs font-semibold uppercase tracking-wider text-base-content/50">{ tr(ctx, f.Label) }</dt>
							<dd class="font-medium">
								if len(f.People) > 0 {
									for i, p := range f.People {
										if i > 0 {
											<span>, </span>
										}
										<a href={ personHref(p.ID) } class="link link-hover">{ p.Name }</a>
									}
								} else {
									{ f.Value }
								}
							</dd>
						</div>
					}
				}
			</dl>
			@officialLinksRow(links)
		</div>
	</section>
}

// torrentActions is the delegated click handler for every release row.
// Magnets travel in data-magnet; the add URL is built from server ints.
func torrentActions(ctx context.Context, addURL string) string {
	send := fmt.Sprintf("$torrMagnet = b.dataset.magnet; @post('%s', {filterSignals: {include: /^torrMagnet$/}})", addURL)
	if siteOf(ctx).Cloud {
		send = `if ($tsSelectorReady && $tsSelected && !$sending) { const section = el.closest('#sources'); tsAddTorrent(section, $tsSelected, {link: b.dataset.magnet, title: section.dataset.title, poster: section.dataset.poster, mediaId: +section.dataset.mediaId, mediaType: section.dataset.mediaType}) }`
	}
	return fmt.Sprintf(`const b = evt.target.closest('button[data-action]')
if (!b) return
if (b.dataset.action === 'send') {
	%s
} else if (b.dataset.action === 'copy') {
	navigator.clipboard.writeText(b.dataset.magnet).then(() => { $toastError = false; $toast = %s }, () => { $toastError = true; $toast = %s })
}`, send, trJS(ctx, "Magnet link copied"), trJS(ctx, "Copy failed"))
}

// SourcesSearch is the Datastar expression that (re)runs the JacRed search
// for a title with the current $sort, the qualities ($qual) and HDR ($hdr)
// picked, and $sourceSeason for series. It is built only from server ints,
// never from upstream text.
func SourcesSearch(mediaType string, id int) string {
	season := ""
	if mediaType == "tv" {
		season = " + '&season=' + $sourceSeason"
	}
	return fmt.Sprintf("$sourcesRequested = true; @get('/api/torrents?type=%s&id=%d&sort=' + $sort%s + '&quality=' + $qual.filter(Boolean).join(',') + ($hdr ? '&hdr=1' : ''), {filterSignals: {include: /^$/}})", mediaType, id, season)
}

// researchSources searches again with search (see SourcesSearch) once
// sources were asked for: when the season or a search filter changes.
func researchSources(search string) string {
	return "if ($sourcesRequested) { " + search + " }"
}

// TorrentAddURL is the endpoint that sends a release of a title to TorrServer.
func TorrentAddURL(mediaType string, id int) string {
	return fmt.Sprintf("/api/torrents/add?type=%s&id=%d", mediaType, id)
}

func sourcesSignals(ctx context.Context, mediaType string, selected int) string {
	cloud := ""
	if siteOf(ctx).Cloud {
		cloud = ", tsSelectorReady: false, tsSelected: localStorage.getItem('mt-ts-selected') || '', _tsAddResult: {adding: false, ok: false, problem: '', status: 0}"
	}
	if mediaType == "tv" {
		return fmt.Sprintf("{ sort: 'seeders', qual: [], hdr: false, sourcesRequested: false, sourcesLoading: false, sourceSeason: '%d'%s }", selected, cloud)
	}
	return "{ sort: 'seeders', qual: [], hdr: false, sourcesRequested: false, sourcesLoading: false" + cloud + " }"
}

// sourcesSection searches JacRed only when the user asks; series search one
// season at a time. The TorrServer status badge loads on its own.
templ sourcesSection(mediaType string, item tmdb.MediaItem, seasons []tmdb.SeasonSummary, selected int, releases tmdb.Releases) {
	{{ id := item.ID }}
	<section id="sources" class="max-w-7xl mx-auto px-4 sm:px-8 py-6 space-y-5 scroll-mt-20" data-signals={ sourcesSignals(ctx, mediaType, selected) } data-media-id={ fmt.Sprint(id) } data-media-type={ mediaType } data-title={ PageTitle(item) } data-poster={ item.PosterURL() }
		if siteOf(ctx).Cloud {
			data-effect="localStorage.setItem('mt-ts-selected', $tsSelected); $_tsNavUrl = $tsSelected; tsResetAdd(el, $tsSelected)"
			data-on:ts-added={ "$sending = evt.detail.adding; $_tsAddResult = evt.detail; if (evt.detail.ok) { $toastError = false; $toast = " + trJS(ctx, "Added to TorrServer") + " }" }
		}
	>
		@sectionHeading(tr(ctx, "Sources"), tr(ctx, "Torrent releases found by JacRed. Send one to your TorrServer to watch.")) {
			if siteOf(ctx).Cloud {
				<div id="ts-source-selector" data-init="@get('/api/ts/selector', {filterSignals: {include: /^$/}})"></div>
			} else {
				<div data-init="@get('/api/torrserver/status')">
					@TorrServerStatus(false, "", "")
				</div>
			}
		}
		@releaseDates(releases, time.Now())
		<div id="torr-activity"></div>
		if siteOf(ctx).Cloud {
			@webSourceProblems()
		}
		<div class="flex flex-wrap items-center gap-2">
			if mediaType == "tv" && len(seasons) > 0 {
				<select
					class="select select-sm w-auto"
					aria-label={ tr(ctx, "Season to search") }
					data-bind:source-season
					data-on:change={ researchSources(SourcesSearch(mediaType, id)) }
				>
					for _, s := range seasons {
						<option value={ fmt.Sprint(s.Number) } selected?={ s.Number == selected }>{ seasonSourcesLabel(ctx, s) }</option>
					}
				</select>
			}
			@searchFilters(SourcesSearch(mediaType, id))
			<button type="button" class="btn btn-primary btn-sm gap-1.5" data-on:click={ SourcesSearch(mediaType, id) } data-indicator:sources-loading data-attr:disabled="$sourcesLoading">
				<span class="loading loading-spinner loading-xs hidden" data-class:hidden="!$sourcesLoading"></span>
				<span data-class:hidden="$sourcesLoading">
					@Icon("search", "size-4")
				</span>
				<span data-text={ "$sourcesRequested ? " + trJS(ctx, "Search again") + " : " + trJS(ctx, "Find sources") }>{ tr(ctx, "Find sources") }</span>
			</button>
			<span class="ml-auto">
				@JacRedCredit()
			</span>
		</div>
		<div data-on:click={ torrentActions(ctx, TorrentAddURL(mediaType, id)) }
			if !siteOf(ctx).Cloud {
				data-indicator:sending
			}
		>
			<div id="torrent-results"></div>
		</div>
	</section>
}

// releaseDates says when a movie first came out in cinemas, digitally and on
// disc, anywhere: what kinds of releases its sources can be by now.
templ releaseDates(rel tmdb.Releases, now time.Time) {
	if !rel.Cinema.IsZero() || !rel.Digital.IsZero() || !rel.Physical.IsZero() {
		<div class="space-y-2">
			<ul class="flex flex-wrap gap-2" aria-label={ tr(ctx, "Release dates") }>
				@releaseDate("clapperboard", "In cinemas", rel.Cinema, now)
				@releaseDate("monitor-play", "Digital", rel.Digital, now)
				@releaseDate("disc-3", "DVD / Blu-ray", rel.Physical, now)
			</ul>
			if onlyInCinemas(rel, now) {
				<div role="note" class="alert alert-warning alert-soft text-sm">
					@Icon("info", "size-4")
					<span>{ tr(ctx, "Not out digitally yet: its sources are likely only cinema recordings (CAMRip, TS).") }</span>
				</div>
			}
		</div>
	}
}

templ releaseDate(icon, label string, day, now time.Time) {
	if !day.IsZero() {
		<li class="badge badge-lg badge-ghost gap-1.5">
			@Icon(icon, "size-4 opacity-70")
			<span class="text-base-content/70">{ tr(ctx, label) }</span>
			<span class="font-medium">{ i18n.Date(ctx, day) }</span>
			if day.After(now) {
				<span class="text-base-content/70">({ tr(ctx, "expected") })</span>
			}
		</li>
	}
}

// cinemaWindow is about how long a movie plays in cinemas before it comes
// out digitally or on disc.
const cinemaWindow = 120 * 24 * time.Hour

// onlyInCinemas is whether a movie is out in cinemas but not yet digitally
// or on disc, so trackers can only have recordings of a screening. A date
// TMDB does not know is not a release still to come: it takes a home
// release announced for later, or a cinema release recent enough that one
// is unlikely to be out yet.
func onlyInCinemas(rel tmdb.Releases, now time.Time) bool {
	if rel.Cinema.IsZero() || rel.Cinema.After(now) {
		return false
	}
	out := func(day time.Time) bool { return !day.IsZero() && !day.After(now) }
	if out(rel.Digital) || out(rel.Physical) {
		return false
	}
	announced := rel.Digital.After(now) || rel.Physical.After(now)
	return announced || now.Sub(rel.Cinema) < cinemaWindow
}

// searchQualities are the qualities JacRed files releases under, as picked
// before a search.
var searchQualities = []struct {
	Value int
	Label string
}{{2160, "4K"}, {1080, "1080p"}, {720, "720p"}, {480, "SD"}}

// searchFilters are picked before searching and sent to JacRed: any
// qualities (none is all) and HDR only. Changing one searches again once
// sources were asked for.
templ searchFilters(search string) {
	<div class="flex flex-wrap items-center gap-2" data-on:change={ researchSources(search) }>
		<div role="group" aria-label={ tr(ctx, "Search for qualities") } class="join">
			for _, q := range searchQualities {
				<label class="btn btn-sm join-item has-checked:btn-primary has-focus-visible:outline-2 has-focus-visible:outline-primary">
					<input type="checkbox" class="sr-only" value={ fmt.Sprint(q.Value) } data-bind="qual"/>
					{ q.Label }
				</label>
			}
		</div>
		<label class="btn btn-sm gap-1.5 has-checked:btn-secondary has-focus-visible:outline-2 has-focus-visible:outline-secondary">
			<input type="checkbox" class="sr-only" data-bind:hdr/>
			@Icon("sun", "size-4")
			{ tr(ctx, "HDR only") }
		</label>
	</div>
}

// TorrServerStatus is patched by /api/torrserver/status. version == "" and
// !online renders the pending state.
templ TorrServerStatus(online bool, version, endpoint string) {
	<a id="torrserver-status" href="/torrserver" class="badge badge-lg gap-2 shrink-0 whitespace-nowrap bg-base-200 border-base-content/10 hover:border-primary" title={ endpoint }>
		if online {
			<span class="status status-success" aria-hidden="true"></span>
			TorrServer { version }
		} else if endpoint != "" {
			<span class="status status-error" aria-hidden="true"></span>
			{ tr(ctx, "TorrServer Offline") }
		} else {
			<span class="loading loading-ring loading-xs" aria-hidden="true"></span>
			{ tr(ctx, "Checking TorrServer…") }
		}
	</a>
}

templ TorrentSearching(title string) {
	<div id="torrent-results" class="space-y-3" aria-busy="true">
		<p class="text-sm text-base-content/70 inline-flex items-center gap-2">
			<span class="loading loading-dots loading-sm text-primary"></span>
			if title != "" {
				<span>{ tr(ctx, "Searching JacRed for") } <span class="font-semibold">{ title }</span>…</span>
			} else {
				<span>{ tr(ctx, "Searching JacRed…") }</span>
			}
		</p>
		<div class="space-y-2">
			for range [3]struct{}{} {
				<div class="skeleton h-16 w-full"></div>
			}
		</div>
	</div>
}

templ TorrentSearchError(message string) {
	<div id="torrent-results" role="alert" class="alert alert-warning alert-soft">
		@Icon("triangle-alert", "size-5")
		<span>{ message }</span>
	</div>
}

func qualityTone(label string) string {
	switch label {
	case "4K":
		return "badge-primary"
	case "1080p":
		return "badge-primary badge-soft"
	case "720p":
		return "badge-outline"
	default:
		return "badge-ghost"
	}
}

// typicalMbps are the bitrates, low to high, usual for a release of each
// vertical resolution: below is starved, above is generous.
var typicalMbps = []struct {
	quality   int
	low, high float64
}{{2160, 12, 35}, {1080, 4, 14}, {720, 2, 6}, {0, 0.8, 2.5}}

// bitrateTone colours a release's bitrate against what is usual for its
// quality: warning when low, success when high.
func bitrateTone(quality int, mbps float64) string {
	for _, t := range typicalMbps {
		if quality >= t.quality {
			switch {
			case mbps < t.low:
				return "text-warning"
			case mbps > t.high:
				return "text-success"
			}
			return ""
		}
	}
	return ""
}

// trackerCount is a tracker and how many releases it has.
type trackerCount struct {
	Name  string
	Count int
}

// trackerCounts lists the trackers of results, busiest first.
func trackerCounts(results []jacred.Result) []trackerCount {
	counts := map[string]int{}
	for _, r := range results {
		if r.Tracker != "" {
			counts[r.Tracker]++
		}
	}
	out := make([]trackerCount, 0, len(counts))
	for name, n := range counts {
		out = append(out, trackerCount{name, n})
	}
	slices.SortFunc(out, func(a, b trackerCount) int {
		if a.Count != b.Count {
			return b.Count - a.Count
		}
		return strings.Compare(a.Name, b.Name)
	})
	return out
}

// maxVoices is how many voices the filter offers: the commonest.
const maxVoices = 12

// voiceCounts counts releases per voice, commonest first. A name with "|"
// is left out: rows list their voices joined by it.
func voiceCounts(results []jacred.Result) []trackerCount {
	counts := map[string]int{}
	for _, r := range results {
		for _, v := range r.Voices {
			if v = strings.TrimSpace(v); v != "" && !strings.Contains(v, "|") {
				counts[v]++
			}
		}
	}
	out := make([]trackerCount, 0, len(counts))
	for name, n := range counts {
		out = append(out, trackerCount{name, n})
	}
	slices.SortFunc(out, func(a, b trackerCount) int {
		if a.Count != b.Count {
			return b.Count - a.Count
		}
		return strings.Compare(a.Name, b.Name)
	})
	return out[:min(len(out), maxVoices)]
}

// trackerNames are how people write the trackers JacRed searches.
var trackerNames = map[string]string{
	"knaben": "Knaben", "bitru": "BitRu", "rutor": "Rutor", "rutracker": "RuTracker", "kinozal": "Kinozal",
	"nnmclub": "NNM-Club", "megapeer": "MegaPeer", "toloka": "Toloka", "selezen": "Selezen",
	"anilibria": "AniLibria", "lostfilm": "LostFilm", "torrentby": "TorrentBy", "baibako": "BaibaKo",
}

func trackerName(tracker string) string {
	if name, ok := trackerNames[strings.ToLower(tracker)]; ok {
		return name
	}
	return tracker
}

var sortOptions = []struct{ Key, Label string }{
	{"seeders", "Seeders"},
	{"date", "Newest"},
	{"size", "Size"},
	{"bitrate", "Bitrate"},
}

// TorrentResults lists releases sorted by sort; search re-runs the query
// (see SourcesSearch) when a different sort is picked.
templ TorrentResults(results []jacred.Result, sort, search string) {
	<div id="torrent-results" class="space-y-4">
		if len(results) == 0 {
			<div role="status" class="alert alert-soft">
				@Icon("search-x", "size-5")
				<span>{ tr(ctx, "No releases found on JacRed for this title.") }</span>
			</div>
		} else {
			<div class="flex flex-wrap items-center justify-between gap-3">
			<div class="flex flex-wrap items-center gap-2">
				@trackerFilter(results)
				@voiceFilter(results)
				if hasRecordings(results) {
					<label class="label text-sm gap-2 cursor-pointer ml-1">
						<input type="checkbox" class="toggle toggle-sm toggle-warning" data-bind="hideRecordings"/>
						{ tr(ctx, "Hide cinema recordings") }
					</label>
				}
			</div>
			<div class="join" role="group" aria-label={ tr(ctx, "Sort releases") }>
				for _, o := range sortOptions {
					<button
						type="button"
						class={ "btn btn-sm join-item", templ.KV("btn-primary", o.Key == sort) }
						aria-pressed={ strconv.FormatBool(o.Key == sort) }
						data-class={ fmt.Sprintf("{ 'btn-primary': $sort === '%s' }", o.Key) }
						data-attr:aria-pressed={ fmt.Sprintf("$sort === '%s'", o.Key) }
						data-on:click={ fmt.Sprintf("$sort = '%s'; %s", o.Key, search) }
					>{ tr(ctx, o.Label) }</button>
				}
			</div>
			</div>
			<ul class="list bg-base-200/50 rounded-box border border-base-content/5 max-h-[32rem] overflow-y-auto overscroll-contain">
				for _, r := range results {
					@torrentRow(r)
				}
			</ul>
			<p class="text-xs text-base-content/50">
				{ tr(ctx, "Results from JacRed. Moviestracker does not host or distribute media — only access content you are legally authorized to use.") }
			</p>
		}
	</div>
}

// trackerFilter picks which trackers' releases show: any number, or all
// when none is picked. Tracker names come from JacRed, so they stay in
// values and data attributes, never in expressions. Datastar binds each
// checkbox to its own slot of $trackers: "" while unticked, its tracker
// while ticked.
templ trackerFilter(results []jacred.Result) {
	{{ trackers := trackerCounts(results) }}
	if len(trackers) > 1 {
		{{ options := make([]filterOption, 0, len(trackers)) }}
		for _, t := range trackers {
			{{ options = append(options, filterOption{Value: t.Name, Label: trackerName(t.Name), Count: t.Count}) }}
		}
		@filterDropdown("trackers", "Trackers", "Filter by tracker", "server", options)
	}
}

// voiceFilter picks which voices' (dubbing's) releases show, the commonest
// first: any number, or all when none is picked. Like tracker names, voice
// names come from JacRed and stay in values and data attributes.
templ voiceFilter(results []jacred.Result) {
	{{ voices := voiceCounts(results) }}
	if len(voices) > 1 {
		{{ options := make([]filterOption, 0, len(voices)) }}
		for _, v := range voices {
			{{ options = append(options, filterOption{Value: v.Name, Label: v.Name, Count: v.Count}) }}
		}
		@filterDropdown("voices", "Voices", "Filter by voice", "mic", options)
	}
}

// filterOption is one choice of a filter dropdown: its value in the
// signal, its name, and how many releases it has.
type filterOption struct {
	Value, Label string
	Count        int
}

// filterDropdown picks any number of options into $signal, one checkbox
// slot each; its button says how many are picked, or All. Option values
// come from JacRed and stay in values, never in expressions.
templ filterDropdown(signal, label, ariaLabel, icon string, options []filterOption) {
	<div class="dropdown" role="group" aria-label={ tr(ctx, ariaLabel) }>
		<div tabindex="0" role="button" class="btn btn-sm gap-1.5" data-class={ fmt.Sprintf("{ 'btn-primary': $%s.some(Boolean) }", signal) }>
			@Icon(icon, "size-4")
			{ tr(ctx, label) }
			<span class="badge badge-xs" data-text={ fmt.Sprintf("$%s.filter(Boolean).length || %s", signal, trJS(ctx, "All")) }>{ tr(ctx, "All") }</span>
			@Icon("chevron-down", "size-3.5 opacity-60")
		</div>
		<ul tabindex="-1" class="dropdown-content menu menu-sm flex-nowrap bg-base-200 rounded-box z-30 mt-1 w-64 max-h-80 overflow-y-auto p-2 shadow-xl border border-base-content/10">
			<li>
				<button type="button" data-class={ fmt.Sprintf("{ 'menu-active': !$%s.some(Boolean) }", signal) } data-on:click={ fmt.Sprintf("$%s = $%s.map(() => '')", signal, signal) }>{ tr(ctx, "All") }</button>
			</li>
			for _, o := range options {
				<li>
					<label class="flex justify-between gap-2">
						<span class="flex items-center gap-2 min-w-0">
							<input type="checkbox" class="checkbox checkbox-xs checkbox-primary" value={ o.Value } data-bind={ signal }/>
							<span class="truncate">{ o.Label }</span>
						</span>
						<span class="badge badge-xs">{ fmt.Sprint(o.Count) }</span>
					</label>
				</li>
			}
		</ul>
	</div>
}

// formatBadges are what a release's name says it is; a cinema recording's
// source warns.
templ formatBadges(f jacred.Format) {
	if f.Source != "" || f.Codec != "" || f.TenBit || f.Audio != "" {
		<p class="flex flex-wrap gap-1">
			if f.Source != "" {
				<span class={ "badge badge-xs font-semibold", templ.KV("badge-warning", f.Recording), templ.KV("badge-soft", !f.Recording) } title={ formatTitle(ctx, f) }>{ f.Source }</span>
			}
			if f.Codec != "" {
				<span class="badge badge-xs badge-ghost">{ f.Codec }</span>
			}
			if f.TenBit {
				<span class="badge badge-xs badge-ghost">10-bit</span>
			}
			if f.Audio != "" {
				<span class="badge badge-xs badge-ghost">{ f.Audio }</span>
			}
		</p>
	}
}

func formatTitle(ctx context.Context, f jacred.Format) string {
	if f.Recording {
		return tr(ctx, "Recorded in a cinema")
	}
	return ""
}

// hasRecordings is whether any release is a cinema recording.
func hasRecordings(results []jacred.Result) bool {
	return slices.ContainsFunc(results, func(r jacred.Result) bool { return r.Format().Recording })
}

// rowShown is whether a release row matches the tracker and voice filters.
const rowShown = `(!$trackers.some(Boolean) || $trackers.includes(el.dataset.tracker)) && ` +
	`(!$voices.some(Boolean) || el.dataset.voices.split('|').some(v => v && $voices.includes(v))) && ` +
	`!($hideRecordings && el.dataset.recording)`

templ torrentRow(r jacred.Result) {
	<li
		class="list-row items-center gap-3 sm:gap-4"
		data-tracker={ r.Tracker }
		data-voices={ strings.Join(r.Voices, "|") }
		if r.Format().Recording {
			data-recording="true"
		}
		data-show={ rowShown }
	>
		<div class="flex flex-col items-center gap-1 w-14">
			<span class={ "badge badge-sm font-bold whitespace-nowrap", qualityTone(r.QualityLabel()) }>{ r.QualityLabel() }</span>
			if r.HDR {
				<span class="badge badge-xs badge-outline">HDR</span>
			}
		</div>
		<div class="min-w-0 list-col-grow space-y-1">
			<p class="text-sm font-medium leading-snug line-clamp-2 break-words" title={ r.Title }>{ r.Title }</p>
			@formatBadges(r.Format())
			<p class="text-xs text-base-content/70 flex flex-wrap items-center gap-x-3 gap-y-1">
				<span class="font-mono">{ r.Tracker }</span>
				if r.SizeName != "" {
					<span>{ r.SizeName }</span>
				}
				if mbps := r.Mbps(); mbps > 0 {
					<span class={ "font-medium tabular-nums", bitrateTone(r.Quality, mbps) } title={ trf(ctx, "Estimated: size over %d min, audio included", int(r.Runtime.Minutes())) }>
						≈ { trf(ctx, "%s Mbps", strconv.FormatFloat(mbps, 'f', 1, 64)) }
					</span>
				}
				if !r.CreatedAt.IsZero() {
					<span title={ tr(ctx, "Added") }>{ r.CreatedAt.Format("2006-01-02") }</span>
				}
				<span class="inline-flex items-center gap-1 text-success" title={ tr(ctx, "Seeders") }>
					@Icon("arrow-up", "size-3")
					{ fmt.Sprint(r.Seeders) }
				</span>
				<span class="inline-flex items-center gap-1" title={ tr(ctx, "Peers") }>
					@Icon("arrow-down", "size-3")
					{ fmt.Sprint(r.Peers) }
				</span>
				if len(r.Voices) > 0 {
					<span class="truncate max-w-64">{ strings.Join(r.Voices, ", ") }</span>
				}
			</p>
		</div>
		<div class="flex items-center gap-1 max-sm:list-col-wrap max-sm:justify-end">
			<button type="button" class="btn btn-primary btn-sm gap-1.5" data-action="send" data-magnet={ r.Magnet }
				if siteOf(ctx).Cloud {
					data-attr:disabled="$sending || !$tsSelectorReady || !$tsSelected"
				} else {
					data-attr:disabled="$sending"
				}
				title={ tr(ctx, "Send to TorrServer") }>
				@Icon("send", "size-4")
				<span>TorrServer</span>
			</button>
			<button type="button" class="btn btn-ghost btn-sm btn-square" data-action="copy" data-magnet={ r.Magnet } title={ tr(ctx, "Copy magnet link") } aria-label={ tr(ctx, "Copy magnet link") }>
				@Icon("magnet", "size-4")
			</button>
			<a href={ templ.SafeURL(r.SourceURL) } target="_blank" rel="noopener noreferrer nofollow" class="btn btn-ghost btn-sm btn-square" title={ trf(ctx, "Open on %s", r.Tracker) } aria-label={ trf(ctx, "Open source page on %s", r.Tracker) }>
				@Icon("external-link", "size-4")
			</a>
		</div>
	</li>
}

// TorrActivity is patched in after a release is sent to TorrServer; it opens
// a stream of that torrent's download stats.
templ TorrActivity(hash, title string) {
	<div id="torr-activity" class="card bg-base-200/60 border border-primary/30" data-init={ fmt.Sprintf("@get('%s')", TorrentStatsURL(hash)) }>
		<div class="card-body p-4 flex-row flex-wrap items-center gap-4">
			<span class="size-10 rounded-box bg-primary/10 text-primary grid place-items-center">
				@Icon("download", "size-5")
			</span>
			<div class="grow min-w-0 space-y-1">
				<p class="font-semibold truncate">{ title }</p>
				@TorrActivityStats(nil)
			</div>
			<a href="/torrserver" class="btn btn-sm btn-primary gap-1.5">
				@Icon("tv-minimal-play", "size-4")
				{ tr(ctx, "Open player") }
			</a>
		</div>
	</div>
}

// TorrentStatsURL streams live stats for one torrent.
func TorrentStatsURL(hash string) string {
	return "/api/torrserver/torrent-stats?hash=" + hash + "&stream=true"
}

templ TorrActivityStats(t *torrserver.Torrent) {
	<div id="torr-activity-stats" class="text-xs text-base-content/70 flex flex-wrap items-center gap-x-4 gap-y-1">
		if t == nil {
			<span class="inline-flex items-center gap-2">
				<span class="loading loading-spinner loading-xs"></span>
				{ tr(ctx, "Waiting for TorrServer…") }
			</span>
		} else {
			<span class={ "badge badge-sm", t.StatusBadgeClass() }>{ tr(ctx, t.StatusLabel()) }</span>
			<span class="inline-flex items-center gap-1">
				@Icon("users", "size-3.5")
				{ t.FormattedPeers() } { tr(ctx, "peers") }
			</span>
			<span class="inline-flex items-center gap-1 font-mono">
				@Icon("arrow-down", "size-3.5")
				{ t.FormattedDownloadSpeed() }
			</span>
			if t.TorrentSize > 0 {
				<span class="inline-flex items-center gap-2 grow min-w-40 max-w-80">
					<progress class="progress progress-primary w-full" value={ fmt.Sprint(t.LoadedSize) } max={ fmt.Sprint(t.TorrentSize) }></progress>
					<span class="font-mono whitespace-nowrap">{ torrserver.FormatBytes(t.LoadedSize) } / { t.FormattedSize() }</span>
				</span>
			}
		}
	</div>
}

// appToast shows $toast for 3s; $toastError switches it to the error tone.
templ appToast() {
	<div
		popover="manual"
		role="status"
		aria-live="polite"
		class="toast toast-end toast-bottom m-0 inset-auto bottom-0 right-0 bg-transparent border-0 overflow-visible [&:not(:popover-open)]:hidden"
		data-effect="if ($toast) { el.matches(':popover-open') ? (el.hidePopover(), el.showPopover()) : el.showPopover() } else if (el.matches(':popover-open')) { el.hidePopover() }"
		data-on-signal-patch__debounce.3s={ toastAutoHide }
		data-on-signal-patch-filter="{ include: /^toast$/ }"
	>
		<div class="alert alert-success shadow-xl text-sm" data-class="{ 'alert-success': !$toastError, 'alert-error': $toastError }">
			<span data-text="$toast"></span>
		</div>
	</div>
}
