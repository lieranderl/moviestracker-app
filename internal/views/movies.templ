package views

import (
	"github.com/lieranderl/moviestracker-app/internal/auth"
	"github.com/lieranderl/moviestracker-app/internal/tmdb"
	"fmt"
	"net/url"
)

// heroTick advances the billboard once per second:
//   - hovered or paused: after 3s start the trailer of the current slide
//   - otherwise: rotate to the next slide every 5s
const heroTick = `
$heroElapsed++
if ($heroPaused || $heroHovered) {
	if ($heroElapsed >= 3) { $heroPlayTrailer = true }
} else if ($heroElapsed >= 5) {
	$heroSlide = ($heroSlide + 1) % $heroTotal
	$heroElapsed = 0
}
`

// heroGoto is appended to any slide change; it resets the timer and trailer.
const heroGoto = `; $heroElapsed = 0; $heroPlayTrailer = false`

// heroMute toggles trailer audio through the YouTube IFrame postMessage API
// (third-party control: the one allowed imperative exception).
const heroMute = `
$heroMuted = !$heroMuted
const cmd = JSON.stringify({ event: 'command', func: $heroMuted ? 'mute' : 'unMute', args: [] })
document.querySelectorAll('iframe[data-trailer-iframe]').forEach(f => f.contentWindow?.postMessage(cmd, 'https://www.youtube-nocookie.com'))
`

// Movies is the authenticated home; discover adds the lazily loaded rails.
templ Movies(user *auth.User, hero []tmdb.MediaItem, movies []tmdb.MediaItem, series []tmdb.MediaItem, discover bool) {
	@Layout("Trending Movies & Series") {
		@Navbar(user)
		<main class="grow pb-20">
			<h1 class="sr-only">Trending movies and TV series</h1>
			if len(hero) > 0 {
				@HeroBillboard(hero)
			} else if len(movies) > 0 {
				@HeroBillboard(movies[:min(len(movies), 5)])
			}
			<div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-10 mt-10">
				@mediaRow("trending-movies", "Trending Movies", "Top trending films from The Movie Database", "film", "text-primary", "badge-primary", "No trending movies available. Please verify TMDB_API_KEY configuration.", movies)
				@mediaRow("trending-series", "Trending TV Series", "Top trending episodic series and releases", "tv", "text-accent", "badge-accent", "No trending TV series available. Please verify TMDB_API_KEY configuration.", series)
				if discover {
					@discoverSection()
				}
			</div>
		</main>
		@siteFooter()
	}
}

templ mediaRow(id, title, subtitle, icon, iconTone, badgeTone, emptyMsg string, items []tmdb.MediaItem) {
	<section id={ id } class="space-y-4" aria-labelledby={ id + "-title" }>
		<header>
			<h2 id={ id + "-title" } class="text-xl sm:text-2xl font-bold tracking-tight flex items-center gap-2">
				@Icon(icon, "size-5 "+iconTone)
				{ title }
				<span class={ "badge badge-sm badge-soft font-semibold", badgeTone }>Weekly</span>
			</h2>
			<p class="text-sm text-base-content/60">{ subtitle }</p>
		</header>
		if len(items) == 0 {
			<div role="status" class="alert alert-info alert-soft">
				@Icon("info", "size-5")
				<span>{ emptyMsg }</span>
			</div>
		} else {
			@carousel() {
				for _, item := range items {
					<li class="carousel-item">
						@MediaCard(item)
					</li>
				}
			}
		}
	</section>
}

templ HeroBillboard(items []tmdb.MediaItem) {
	if len(items) > 0 {
		<section
			aria-roledescription="carousel"
			aria-label="Trending highlights"
			data-signals={ fmt.Sprintf("{ heroSlide: 0, heroTotal: %d, heroPaused: false, heroHovered: false, heroElapsed: 0, heroPlayTrailer: false, heroMuted: true }", len(items)) }
			data-on-interval__duration.1s={ heroTick }
			data-on:mouseenter="$heroHovered = true; if (!$heroPlayTrailer) { $heroElapsed = 0 }"
			data-on:mouseleave="$heroHovered = false; if (!$heroPaused) { $heroPlayTrailer = false; $heroElapsed = 0 }"
			class="relative w-full overflow-hidden bg-base-300"
		>
			if req := heroIMDbRequest(items); req != "" {
				<div class="hidden" data-init={ req }></div>
			}
			<div id="hero-carousel" class="relative min-h-[520px] lg:min-h-[640px]">
				for idx, item := range items {
					@heroSlide(idx, len(items), item)
				}
			</div>
			if len(items) > 1 {
				<div class="absolute inset-x-4 top-1/2 hidden sm:flex -translate-y-1/2 justify-between pointer-events-none z-20">
					@heroArrow("Previous slide", "chevron-left", "$heroSlide = ($heroSlide - 1 + $heroTotal) % $heroTotal"+heroGoto)
					@heroArrow("Next slide", "chevron-right", "$heroSlide = ($heroSlide + 1) % $heroTotal"+heroGoto)
				</div>
			}
			<!-- Trailer sound toggle (only visible while a trailer plays) -->
			<div class="absolute right-4 sm:right-8 bottom-20 sm:bottom-24 z-30">
				<button
					type="button"
					data-class:hidden="!$heroPlayTrailer"
					data-on:click={ heroMute }
					data-attr:aria-pressed="!$heroMuted"
					class="btn btn-circle btn-sm bg-base-100/70 backdrop-blur-md border-base-content/20 hover:bg-base-100 shadow-xl hidden"
					aria-label="Toggle trailer sound"
					title="Mute / unmute trailer"
				>
					<span data-class:hidden="!$heroMuted">
						@Icon("volume-x", "size-4")
					</span>
					<span class="hidden" data-class:hidden="$heroMuted">
						@Icon("volume-2", "size-4")
					</span>
				</button>
			</div>
			if len(items) > 1 {
				<div class="flex w-full justify-center items-center gap-1.5 sm:gap-2.5 py-3 px-4 bg-base-200 border-b border-base-content/10 overflow-x-auto" role="group" aria-label="Choose slide">
					for idx, item := range items {
						<button
							type="button"
							data-on:click={ fmt.Sprintf("$heroSlide = %d", idx) + heroGoto }
							data-class={ fmt.Sprintf("{ 'btn-primary': $heroSlide === %d, 'btn-ghost': $heroSlide !== %d }", idx, idx) }
							data-attr:aria-current={ fmt.Sprintf("$heroSlide === %d ? 'true' : null", idx) }
							class={ "btn btn-xs sm:btn-sm rounded-full gap-2", templ.KV("btn-primary", idx == 0), templ.KV("btn-ghost", idx != 0) }
							title={ item.Title }
						>
							<span class="max-w-[140px] sm:max-w-[200px] truncate">{ item.Title }</span>
							<span class="badge badge-xs badge-ghost font-mono hidden md:inline-flex">{ fmt.Sprint(idx + 1) }</span>
						</button>
					}
				</div>
			}
		</section>
	}
}

templ heroArrow(label, icon, action string) {
	<button
		type="button"
		data-on:click={ action }
		class="btn btn-circle bg-base-100/70 backdrop-blur-md border-base-content/20 hover:bg-base-100 pointer-events-auto shadow-xl"
		aria-label={ label }
		title={ label }
	>
		@Icon(icon, "size-5")
	</button>
}

templ heroSlide(idx, total int, item tmdb.MediaItem) {
	<article
		id={ fmt.Sprintf("hero-slide-%d", idx) }
		aria-roledescription="slide"
		aria-label={ fmt.Sprintf("%d of %d: %s", idx+1, total, item.Title) }
		class={ "absolute inset-0 flex items-end", templ.KV("hidden", idx != 0) }
		data-class={ fmt.Sprintf("{ hidden: $heroSlide !== %d }", idx) }
	>
		<!-- Backdrop (decorative; native <img> keeps CSP style-src intact) -->
		if item.BackdropURL() != "" {
			<img
				src={ item.BackdropURL() }
				alt=""
				class="absolute inset-0 size-full object-cover"
				if idx == 0 {
					fetchpriority="high"
				} else {
					loading="lazy"
				}
				decoding="async"
			/>
		} else if item.PosterURL() != "" {
			<img
				src={ item.PosterURL() }
				alt=""
				class="absolute inset-0 size-full object-cover blur-3xl opacity-35 scale-110"
				loading="lazy"
				decoding="async"
			/>
		} else {
			<div class="absolute inset-0 bg-linear-to-br from-neutral via-base-300 to-base-100"></div>
		}
		<!-- Trailer: fades in after 1.2s to hide YouTube's initial play bezel -->
		if item.TrailerKey != "" {
			<div
				data-class={ fmt.Sprintf("{ 'trailer-fade-in': $heroPlayTrailer && $heroSlide === %d, 'trailer-fade-out': !($heroPlayTrailer && $heroSlide === %d) }", idx, idx) }
				class="absolute inset-0 overflow-hidden pointer-events-none opacity-0"
			>
				<iframe
					data-trailer-iframe
					title={ item.Title + " trailer" }
					data-attr:src={ fmt.Sprintf("($heroPlayTrailer && $heroSlide === %d) ? 'https://www.youtube-nocookie.com/embed/%s?autoplay=1&controls=0&playsinline=1&rel=0&iv_load_policy=3&disablekb=1&enablejsapi=1&mute=' + (@peek(() => $heroMuted) ? 1 : 0) : null", idx, url.PathEscape(item.TrailerKey)) }
					class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[180%] h-[180%] min-w-full min-h-full border-0"
					allow="autoplay; encrypted-media"
					tabindex="-1"
				></iframe>
			</div>
		}
		<!-- Scrims: bottom fade into the indicator bar + left scrim for legibility -->
		<div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/35 via-40% to-transparent pointer-events-none"></div>
		<div class="absolute inset-0 bg-linear-to-r from-black/70 via-black/25 via-40% to-transparent sm:max-w-3xl pointer-events-none"></div>
		<div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-12 py-12 lg:py-16 text-white">
			<div class="max-w-2xl space-y-4">
				<div class="flex flex-wrap items-center gap-2">
					<span class="badge h-7 px-3 gap-1.5 text-xs font-semibold bg-black/50 backdrop-blur-md border-white/20 text-white">
						@Icon("sparkles", "size-3.5 text-primary")
						Trending <span class="text-primary font-bold">#{ fmt.Sprint(idx + 1) }</span>
					</span>
					@tmdbRatingBadge(item)
					if item.ImdbID != "" {
						@pendingIMDbRating(heroIMDbBadgeID(idx))
					}
					if item.ReleaseYear() != "" {
						<span class="badge h-7 px-3 text-xs font-medium font-mono bg-black/50 backdrop-blur-md border-white/20 text-white">{ item.ReleaseYear() }</span>
					}
					<span class="badge h-7 px-3 text-xs font-medium font-mono uppercase bg-black/50 backdrop-blur-md border-white/20 text-white">
						{ mediaTypeLabel(item.MediaType, "TV Series") }
					</span>
				</div>
				<h2 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight drop-shadow-lg">
					if item.LogoURL() != "" {
						<img
							src={ item.LogoURL() }
							alt={ item.Title }
							class="max-h-20 sm:max-h-28 md:max-h-36 max-w-[280px] sm:max-w-md w-auto object-contain drop-shadow-xl"
							if idx != 0 {
								loading="lazy"
							}
						/>
					} else {
						{ item.Title }
					}
				</h2>
				if item.Overview != "" {
					<p class="line-clamp-3 text-sm sm:text-base text-white/85 drop-shadow max-w-xl font-medium leading-relaxed">
						{ item.Overview }
					</p>
				}
				<div class="pt-3 flex flex-wrap gap-3">
					<a href={ mediaHref(item) } class="btn bg-white text-black border-white hover:bg-white/85 gap-2 shadow-lg">
						@Icon("info", "size-4")
						More info
					</a>
					<button
						type="button"
						data-on:click="$heroPaused = !$heroPaused; $heroPlayTrailer = $heroPaused; $heroElapsed = 0"
						data-attr:aria-pressed="$heroPaused"
						class="btn btn-ghost text-white border-white/30 hover:bg-white/10 gap-2"
					>
						<span data-class:hidden="$heroPaused">
							@Icon("play", "size-4 fill-current")
						</span>
						<span class="hidden" data-class:hidden="!$heroPaused">
							@Icon("square", "size-4 fill-current")
						</span>
						<span data-text="$heroPaused ? 'Stop Preview' : 'Play Preview'">Play Preview</span>
					</button>
				</div>
			</div>
		</div>
	</article>
}

func heroIMDbBadgeID(idx int) string { return fmt.Sprintf("hero-imdb-rating-%d", idx) }

// heroIMDbRequest fetches every slide's IMDb rating with one request.
func heroIMDbRequest(items []tmdb.MediaItem) string {
	badges := make(map[string]string)
	for idx, item := range items {
		if item.ImdbID != "" {
			badges[heroIMDbBadgeID(idx)] = item.ImdbID
		}
	}
	if len(badges) == 0 {
		return ""
	}
	return "@get('" + IMDbRatingURL(badges) + "')"
}

func mediaTypeLabel(mediaType, tvLabel string) string {
	if mediaType == "tv" {
		return tvLabel
	}
	return "Movie"
}

templ MediaCard(item tmdb.MediaItem) {
	<a href={ mediaHref(item) } class="card bg-base-200/60 hover:bg-base-200 border border-base-content/5 w-40 sm:w-48 shadow-md hover:shadow-lg transition duration-300 hover:-translate-y-1.5 group shrink-0 focus-visible:outline-2 focus-visible:outline-primary">
		<figure class="aspect-[2/3] relative bg-base-300">
			if item.PosterURL() != "" {
				<img
					src={ item.PosterURL() }
					alt={ item.Title + " poster" }
					class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
					loading="lazy"
					decoding="async"
					width="192"
					height="288"
				/>
			} else {
				<div class="size-full flex flex-col items-center justify-center p-4 text-center">
					@Icon("film", "size-10 opacity-40 mb-2")
					<span class="text-xs text-base-content/50 line-clamp-2">{ item.Title }</span>
				</div>
			}
			if item.VoteAverage > 0 {
				<span class="badge badge-warning font-bold text-xs gap-1 shadow-md absolute top-2.5 left-2.5">
					@Icon("star", "size-3 fill-current")
					{ item.FormattedRating() }
				</span>
			}
		</figure>
		<div class="card-body p-3.5 gap-1.5">
			<h3 class="card-title text-sm line-clamp-1 group-hover:text-primary transition-colors leading-tight" title={ item.Title }>
				{ item.Title }
			</h3>
			<div class="flex items-center justify-between text-xs text-base-content/60">
				<span class="font-mono">{ item.ReleaseYear() }</span>
				<span class="badge badge-neutral badge-xs font-mono uppercase">{ mediaTypeLabel(item.MediaType, "TV") }</span>
			</div>
		</div>
	</a>
}
