package views

import (
	"cmp"
	"slices"

	"github.com/lieranderl/moviestracker-app/internal/torrserver"
)

// maxRecentTorrents is how many of the last added torrents home shows.
const maxRecentTorrents = 6

// WebRecentTorrentsSlot is the web app's home row of the torrents last added
// to the visitor's TorrServer. Only the browser can reach it: it lists the
// TorrServer last picked and posts the list, which the server renders into
// #recent-torrents-row (WebRecentTorrents).
templ WebRecentTorrentsSlot() {
	<section
		id="recent-torrents"
		data-signals:_ts-recent-url="localStorage.getItem('mt-ts-selected') || ''"
		data-effect="$_tsRecentUrl && tsList(el, $_tsRecentUrl)"
		data-on:ts-torrents="@post('/api/ts/recent', {payload: {torrents: evt.detail}})"
	>
		<div id="recent-torrents-row"></div>
	</section>
}

// WebRecentTorrents is the row of the torrents added last, newest first;
// nothing when the TorrServer has none.
templ WebRecentTorrents(torrents []torrserver.Torrent) {
	<div id="recent-torrents-row">
		if recent := recentTorrents(torrents); len(recent) > 0 {
			<div class="space-y-4">
				<header class="flex items-end justify-between gap-4">
					<h2 class="text-xl sm:text-2xl font-bold tracking-tight flex items-center gap-2">
						@Icon("server", "size-5 text-primary")
						{ tr(ctx, "Recently added to TorrServer") }
					</h2>
					<a href="/torrserver" class="btn btn-ghost btn-sm gap-1">
						{ tr(ctx, "Open TorrServer") }
						@Icon("chevron-right", "size-4")
					</a>
				</header>
				<ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
					for _, t := range recent {
						<li>
							<a href="/torrserver" class="card bg-base-200/60 hover:bg-base-200 border border-base-content/5 shadow-md transition group focus-visible:outline-2 focus-visible:outline-primary">
								<figure class="aspect-[2/3] bg-base-300">
									if t.Poster != "" {
										<img src={ t.Poster } alt="" class="size-full object-cover" loading="lazy" decoding="async"/>
									} else {
										@Icon("film", "size-10 opacity-40")
									}
								</figure>
								<div class="card-body p-3 gap-1.5">
									<h3 class="text-sm font-semibold line-clamp-2 leading-tight group-hover:text-primary" title={ t.DisplayName() }>{ t.DisplayName() }</h3>
									<span class={ "badge badge-xs", t.StatusBadgeClass() }>{ tr(ctx, t.StatusLabel()) }</span>
								</div>
							</a>
						</li>
					}
				</ul>
			</div>
		}
	</div>
}

// recentTorrents are the torrents added last, newest first.
func recentTorrents(torrents []torrserver.Torrent) []torrserver.Torrent {
	out := slices.Clone(torrents)
	slices.SortStableFunc(out, func(a, b torrserver.Torrent) int { return cmp.Compare(b.Timestamp, a.Timestamp) })
	return out[:min(len(out), maxRecentTorrents)]
}
