# Moviestracker reads this file (.env) at startup for development; a normal
# install configures everything in the browser (Settings → Sources).

# Address to listen on (default :8095, every network interface)
MT_LISTEN=
# Where accounts, sessions and sources are kept (default: "moviestracker" in the
# user config directory; `make run`/`make dev` use .devdata)
MT_DATA_DIR=
# Extra hostnames the server answers to besides IP addresses, localhost and
# <this machine>.local, e.g. "media.home"
MT_HOSTNAMES=
# Secure cookies and HSTS: turn on only when serving over HTTPS (default false)
MT_SECURE_COOKIES=

# Optional overrides of Settings → Sources. A variable set here makes that
# setting read-only in the UI.
TMDB_API_KEY=
JACRED_URL=
JACRED_APIKEY=
IMDB_SERVICE_URL=
TORRSERVER_URL=

# Comma-separated trusted reverse proxy CIDRs (e.g. "127.0.0.1/32")
# When set, the first untrusted IP traversing X-Forwarded-For right-to-left is treated as client identity.
TRUSTED_PROXY_CIDRS=
