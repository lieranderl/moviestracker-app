# Settings for running the cloud web app locally (make web, make web-dev).
# Copy to .env.web (git-ignored) and fill in. On Cloud Run the same names are
# set on the service, the secrets from Secret Manager.

# The web app's Google OAuth client ("Moviestracker web", Web application),
# with http://localhost:8080/auth/google/callback among its redirect URIs.
MT_WEB_GOOGLE_CLIENT_ID=
MT_WEB_GOOGLE_CLIENT_SECRET=

# Signs session cookies: any long random string for local runs
# (openssl rand -base64 48). Cloud Run: secret WEB_SESSION_KEY.
MT_WEB_SESSION_KEY=

# Where Google sends visitors back to after signing in.
MT_WEB_BASE_URL=http://localhost:8080
