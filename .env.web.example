# Settings for running the cloud web app locally (make web, make web-dev).
# Copy to .env.web (git-ignored) and fill in. On Cloud Run the same names are
# set on the service, the secrets from Secret Manager.

# The web app's Google OAuth client ("Moviestracker web", Web application),
# with http://localhost:8080/auth/google/callback among its redirect URIs.
MT_WEB_GOOGLE_CLIENT_ID=
MT_WEB_GOOGLE_CLIENT_SECRET=

# Signs session cookies: any long random string for local runs
# (openssl rand -base64 48). Cloud Run: secret WEB_SESSION_KEY.
MT_WEB_SESSION_KEY=

# Where Google sends visitors back to after signing in.
MT_WEB_BASE_URL=http://localhost:8080

# Keep users' preferences and favourites in Firestore; without these they
# are kept in memory until the app stops. Locally, the emulator
# (make firestore) with any demo- project; on Cloud Run the real database.
# MT_WEB_FIRESTORE_PROJECT=demo-moviestracker
# MT_WEB_FIRESTORE_DATABASE=moviestracker
# FIRESTORE_EMULATOR_HOST=localhost:8086

# The catalog: a TMDB API key (v3 key or read access token). Cloud Run:
# secret TMDB_API_KEY. IMDb ratings come from MT_WEB_IMDB_URL, else the
# Moviestracker rating service.
MT_WEB_TMDB_KEY=

# Shared JacRed project key; kept server-side. Cloud Run: JACRED_APIKEY.
MT_WEB_JACRED_KEY=
